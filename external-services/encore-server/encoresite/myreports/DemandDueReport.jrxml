	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[Branchset Code]]></parameterDescription>
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.customer_id, a.account_id, a.first_name, a.middle_name,
a.last_name, p.branch_code, p.account_name, w.first_disbursement_date,
w.total_disbursed_magnitude,w.total_demand_due_magnitude, w.next_demand_run_date,
w.total_normal_interest_due_magnitude, w.total_principal_due_magnitude,
w.total_penal_interest_due_magnitude, p.currency_code from account_holders a, loan_od_working_registers w,
account_profiles p,branchset_branches b where w.tenant_code = b.tenant_code and
w.tenant_code = a.tenant_code and p.tenant_code = a.tenant_code and
a.account_id = w.account_id and a.account_id = p.account_id and a.holder_num = 1
and p.branch_code = b.branch_code and a.tenant_code = $P{tenant_code} and b.branchset_code=$P{branchset_code_select}
and w.total_demand_due_magnitude > 0  order by a.account_id]]>
	</queryString>
