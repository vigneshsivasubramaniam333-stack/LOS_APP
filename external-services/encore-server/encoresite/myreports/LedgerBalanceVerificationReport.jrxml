<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LedgerBalanceVerificationReport" language="groovy" pageWidth="700" pageHeight="1000" whenNoDataType="BlankPage" columnWidth="700" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="4a8a4ddd-f6e6-495e-913f-6c0398475db7">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select * from (select sum(balance_magnitude) as ANormalInterestAccrued from account_balances where account_id in (select distinct p.account_id from account_profiles
p,loan_od_products lp where lp.interest_accrued_account_code = p.product_code and p.currency_code=lp.currency_code and lp.tenant_code = p.tenant_code and p.product_code like '%IntAccr' and lp.tenant_code = $P{tenant_code}) and tenant_code=$P{tenant_code}) as t1,(SELECT sum(booked_not_due_normal_interest_magnitude) as TNormalInterestAccrued FROM loan_od_working_registers where tenant_code=$P{tenant_code}) as t2 ,
(select sum(balance_magnitude) as ANormalInterestReceivable from account_balances where account_id in (select distinct p.account_id from account_profiles p,
loan_od_products lp where lp.interest_receivable_account_code = p.product_code and p.currency_code=lp.currency_code and lp.tenant_code = p.tenant_code and p.product_code like '%IntRcv' and lp.tenant_code = $P{tenant_code}) and tenant_code=$P{tenant_code}) as t3, (SELECT sum(total_normal_interest_due_magnitude) TNormalInterestReceivable FROM loan_od_working_registers where tenant_code=$P{tenant_code}) as t4,
(select sum(balance_magnitude) as APenalInterestAccrued from account_balances where account_id in (select distinct p.account_id from account_profiles p,loan_od_products lp where lp.penal_interest_accrued_account_code = p.product_code and p.currency_code=lp.currency_code and lp.tenant_code = p.tenant_code and p.product_code like '%PnlIntAccr' and lp.tenant_code = $P{tenant_code}) and tenant_code=$P{tenant_code}) as t5,
(SELECT sum(booked_not_due_penal_interest_magnitude) as TPenalInterestAccrued FROM loan_od_working_registers where tenant_code=$P{tenant_code}) as t6,(select sum(balance_magnitude) as APenalInterestReceivable from account_balances where account_id in (select distinct p.account_id from account_profiles p,
loan_od_products lp where lp.penal_interest_receivable_account_code = p.product_code and p.currency_code=lp.currency_code and lp.tenant_code = p.tenant_code and p.product_code like  '%PnlIntRcv' and lp.tenant_code = $P{tenant_code}) and tenant_code=$P{tenant_code}) as t7,(SELECT sum(total_penal_interest_due_magnitude) as TPenalInterestReceivable FROM loan_od_working_registers where tenant_code=$P{tenant_code}) as t8,(select sum(b.balance_magnitude) as AFeeReceivable from account_balances b, account_profiles p where b.account_id = p.account_id and b.tenant_code =
p.tenant_code and p.product_code ="FeeRcv" and p.product_type = 'Internal' and p.tenant_code = $P{tenant_code}) as t11, (SELECT sum(total_fee_due_magnitude) as TFeeReceivable FROM loan_od_working_registers where tenant_code=$P{tenant_code}) as t12]]>
	</queryString>
	<field name="ANormalInterestAccrued" class="java.math.BigDecimal"/>
	<field name="TNormalInterestAccrued" class="java.math.BigDecimal"/>
	<field name="ANormalInterestReceivable" class="java.math.BigDecimal"/>
	<field name="TNormalInterestReceivable" class="java.math.BigDecimal"/>
	<field name="APenalInterestAccrued" class="java.math.BigDecimal"/>
	<field name="TPenalInterestAccrued" class="java.math.BigDecimal"/>
	<field name="APenalInterestReceivable" class="java.math.BigDecimal"/>
	<field name="TPenalInterestReceivable" class="java.math.BigDecimal"/>
	<field name="AFeeReceivable" class="java.math.BigDecimal"/>
	<field name="TFeeReceivable" class="java.math.BigDecimal"/>
