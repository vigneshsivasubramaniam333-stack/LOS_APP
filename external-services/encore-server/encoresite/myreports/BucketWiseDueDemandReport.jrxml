<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.6.0.final using JasperReports Library version 6.6.0  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BucketWiseDueDemandReport" pageWidth="2200" pageHeight="842" columnWidth="2200" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="fbcb9f93-6da5-441e-a779-26946f3c3a3e">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="encoredb"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select t.account_id,t.demand_num,t.demand_date,t.principal,t.normal_interest,t.penal_interest,t.demand_amount,t.total_demand_due,
		t.demand_due,t.principal_due,t.normal_interest_due,t.penal_interest_due, t.OD_Days, t.tenant_code,
		concat(COALESCE(h.first_name,''),(case when COALESCE(h.middle_name,'')='' then '' else (concat(' ',COALESCE(h.middle_name,''))) end),' ',COALESCE(h.last_name,'')) as customerName,
		concat(COALESCE(cs.first_name,''),(case when COALESCE(cs.middle_name,'')='' then '' else (concat(' ',COALESCE(cs.middle_name,''))) end),' ',COALESCE(cs.last_name,'')) as guarantorName,
		c.sector, -ab.balance_magnitude as ledgerBalance
from (select account_id, demand_num, demand_date, principal_magnitude as principal, normal_interest_magnitude as normal_interest, penal_interest_magnitude as penal_interest, 
		   amount_magnitude as demand_amount, total_demand_due_magnitude as total_demand_due, demand_due,
		   least(demand_due-least(demand_due, penal_interest_magnitude), principal_magnitude) as principal_due, 
		   least(demand_due-least(demand_due-least(demand_due, penal_interest_magnitude), principal_magnitude)-least(demand_due, penal_interest_magnitude), normal_interest_magnitude) as normal_interest_due, 
		   least(demand_due, penal_interest_magnitude) as penal_interest_due, 
		   DATEDIFF(b.current_working_date, demand_date) as 'OD_Days', d.tenant_code
		from (select d1.tenant_code as tenant_code, d1.account_id as account_id, d1.demand_num as demand_num, d1.demand_date as demand_date, 
				 d1.amount_magnitude as amount_magnitude, d1.principal_magnitude as principal_magnitude,
				 d1.normal_interest_magnitude as normal_interest_magnitude, d1.penal_interest_magnitude as penal_interest_magnitude, w.total_demand_due_magnitude,
				 greatest(0, least(d1.amount_magnitude, w.total_demand_due_magnitude+d1.amount_magnitude-(
					 select sum(d2.amount_magnitude) from loan_od_demands d2 where d2.account_id = d1.account_id and d2.tenant_code = d1.tenant_code and d2.id >= d1.id)
				 )) as demand_due
			  from loan_od_demands d1, loan_od_working_registers w 
			  where w.tenant_code = d1.tenant_code and w.account_id = d1.account_id and w.total_demand_due_magnitude > 0 and w.tenant_code = $P{tenant_code}) d, banks b
		where d.demand_due > 0 and d.tenant_code = b.tenant_code) t, customers c,account_holders h, 
		loan_od_profiles l left join customers cs on ( l.tenant_code = cs.tenant_code and l.guarantor_customer_id1 = cs.customer_id), account_balances ab 
where t.tenant_code=c.tenant_code and c.tenant_code=h.tenant_code and h.tenant_code=l.tenant_code and l.tenant_code=ab.tenant_code and l.tenant_code = $P{tenant_code}
		and c.customer_id=h.customer_id and h.holder_num=1 and h.account_id=l.account_id and l.account_id=ab.account_id and t.account_id=l.account_id order by t.account_id, t.demand_num]]>
	</queryString>
