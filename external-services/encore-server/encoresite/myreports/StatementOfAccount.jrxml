	<queryString>
		<![CDATA[select distinct ah.customer_id,concat(COALESCE(ah.first_name,''),' ',COALESCE(ah.middle_name,''),' ',COALESCE(ah.last_name,'')) as customer_name,
concat(COALESCE(ah.address1,''),' ',COALESCE(ah.address2,''),' ',COALESCE(ah.address3,''),' ',COALESCE(ah.city_code,''),' ',
COALESCE(ah.state_code,''),' ',COALESCE(ah.district_code,''),' ',COALESCE(ah.pin_code,'')) as address1,ifnull(ah.phone1,'N/A') as phone1,ifnull(ah.phone2,'N/A') as phone2,
ifnull(ah.email,'N/A') as email,ah.holder_num,(lw.total_disbursed_magnitude-lw.total_principal_repaid_magnitude) as balance_magnitude,
case when ap.operational_status=0 then 'ACTIVE' when ap.operational_status=1 then 'INACTIVE' when ap.operational_status=2 then 'CLOSED'
when ap.operational_status=3 then 'FROZEN' when ap.operational_status=4 then 'WRITE_OFF' when ap.operational_status=5 then 'SETTLED' end as operational_status,
ap.opened_on_value_date,ps.product_code,ps.product_description,b.branch_code,b.branch_name, bk.current_working_date,
lw.first_repayment_date, (lw.total_principal_repaid_magnitude+lw.total_normal_interest_repaid_magnitude+lw.total_penal_interest_repaid_magnitude) as amountPaid,lw.installment_amount_magnitude,lw.account_id,concat(format(lp.normal_interest_rate*100,2),'%') as normal_interest_rate, lw.total_disbursed_magnitude,lw.maturity_date,
case when p.repayment_method=0 then 'BULLET LOAN'
when p.repayment_method=1 then 'EQUATED LOAN'
when p.repayment_method=2 then 'OVERDRAFT LOAN' END as repayment_method,
case when ld.instrument=0 then 'OPERATIVE_ACCOUNT' when ld.instrument=1 then 'CASH' when ld.instrument=2 then 'CHEQUE_OR_DD' when ld.instrument=3 then 'ELECTRONIC'
when ld.instrument=4 then 'OTHER' when ld.instrument=5 then 'NEFT' when ld.instrument=6 then 'RTGS' when ld.instrument=7 then 'IMPS' when ld.instrument=8 then 'UPI'
when ld.instrument=9 then 'AUTOPAY' when ld.instrument=10 then 'DEBIT_CARD' when ld.instrument=11 then 'CREDIT_CARD' when ld.instrument=12 then 'CUSTOM1' 
when ld.instrument=13 then 'CUSTOM2'when ld.instrument=14 then 'CUSTOM3' else 'SECURITY_DEPOSIT' end as instrument, lp.tenure_months, 
case when lp.tenure_unit=0 then 'NONE' when lp.tenure_unit=1 then 'DAY' when lp.tenure_unit=2 then 'WEEK' when lp.tenure_unit=3 then 'FORTNIGHT' 
when lp.tenure_unit=4 then 'MONTH' when lp.tenure_unit=5 then 'QUARTER' when lp.tenure_unit=6 then 'HALF-YEAR' when lp.tenure_unit=7 then 'YEAR' end as frequency, 
lw.first_disbursement_date, ifnull(lw.last_disbursement_date,'N/A') as last_disbursement_date, ld.amount_magnitude, (ld.amount_magnitude-ld.net_disbursement_magnitude) as due_magnitude,
ifnull(lw.num_repayments,0) as num_repayments,ifnull(lw.total_principal_due_magnitude,0) as total_principal_due_magnitude , ifnull(lw.total_normal_interest_due_magnitude,0) as total_normal_interest_due_magnitude, ifnull(lw.security_deposit_magnitude,0) as security_deposit_magnitude,lw.total_principal_repaid_magnitude,
(ld.amount_magnitude-lw.total_principal_repaid_magnitude) as future_principal , lw.total_principal_due_magnitude as principal_due,
ifnull((ld.amount_magnitude-lw.total_principal_repaid_magnitude+lw.total_principal_due_magnitude),0) as total_principal,
sum(ifnull(lw.total_normal_interest_due_magnitude,0)+ifnull(security_deposit_magnitude,0)) as interest_due, lw.total_fee_due_magnitude,
sum(ld.amount_magnitude-lw.total_principal_repaid_magnitude+lw.total_principal_due_magnitude+lw.total_normal_interest_due_magnitude+lw.security_deposit_magnitude+lw.total_fee_due_magnitude) as net_receivable
from account_profiles ap, loan_od_working_registers lw,  
loan_od_products p, products ps, account_holders ah,branches b, banks bk, loan_od_disbursements ld,
loan_od_profiles lp
where ap.tenant_code=lw.tenant_code and lw.tenant_code=lp.tenant_code and 
lp.tenant_code=p.tenant_code and p.tenant_code=ps.tenant_code and ps.tenant_code=b.tenant_code and b.tenant_code=bk.tenant_code and 
ap.account_id=lw.account_id and lw.account_id=lp.account_id and ap.branch_code=b.branch_code and
ld.tenant_code=lw.tenant_code and lw.tenant_code= b.tenant_code
and ld.account_id=lw.account_id and lp.account_id=ah.account_id and
ap.product_code=p.product_code and p.product_code=ps.product_code and ap.product_type='Loans' 
and ah.holder_num=1 and ah.tenant_code=$P{tenant_code} and lp.account_id=$P{accountId_text}]]>
	</queryString>
