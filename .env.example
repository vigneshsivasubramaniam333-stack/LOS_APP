# Infrastructure
POSTGRES_USER=los_admin
POSTGRES_PASSWORD=los_secret_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=los_redis_2026

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=los_rabbit
RABBITMQ_PASSWORD=los_rabbit_2026

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=los_minio_admin
S3_SECRET_KEY=los_minio_secret_2026
S3_BUCKET=los-documents
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=los_minio_admin
MINIO_SECRET_KEY=los_minio_secret_2026

LOS_DOCUMENT_STORAGE=local
FILE_UPLOAD_DIR=./uploads

# JWT
JWT_SECRET=change-this-to-a-secure-random-value-in-production
JWT_ACCESS_TOKEN_EXPIRY=900000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# Services
EUREKA_HOST=localhost
EUREKA_PORT=8761

# Docker prod UI (host port; keep 8080 when host nginx uses port 80)
LOS_UI_HOST_PORT=8080

# Encore LMS (remote HTTP API — no local vendor Docker stack)
# Credinnov EC2 (must include /credinnov-encore-server/ context path on :8091)
ENCORE_BASE_URL=http://host.docker.internal:8091/credinnov-encore-server/encore/
ENCORE_API_USERNAME=
ENCORE_API_PASSWORD=
