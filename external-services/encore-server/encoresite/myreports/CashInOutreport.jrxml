	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[(select f.payment_value_date as Date,ah.customer_id as URN_No,f.account_id as Account_No,
f.payment_transaction_id as Transaction_Id,f.paid_amount_magnitude as Amount,
f.description as Type,ap.product_code as Product,ap.account_name as Product_name, b.branch_name as Branch_name, b.branch_code as Branch_Code from fee_payments f, account_profiles ap, account_holders ah, branches b where f.tenant_code=ap.tenant_code and ah.holder_num=1 and f.account_id=ap.account_id and ap.tenant_code=ah.tenant_code and ah.tenant_code=b.tenant_code
and ap.account_id=ah.account_id and ap.branch_code=b.branch_code and ap.tenant_code=$P{tenant_code} and f.payment_value_date>=$P{from_date} and f.payment_value_date<=$P{to_date})
union All
(SELECT ld.value_date,ah.customer_id,ld.account_id,ld.transaction_id,ld.amount_magnitude,case when ld.repayment_type =0 then 'Scheduled' when ld.repayment_type<>0 then 'Unscheduled'  end as description,ap.product_code as Product,ap.account_name as Product_name, b.branch_name as Branch_name,b.branch_code as Branch_Code FROM loan_od_repayments ld ,account_profiles ap, account_holders ah,branches b where ld.tenant_code=ap.tenant_code and ah.holder_num=1 and ld.account_id=ap.account_id and ap.tenant_code=ah.tenant_code and ap.account_id=ah.account_id and ah.tenant_code=b.tenant_code and ap.branch_code=b.branch_code and ap.tenant_code=b.tenant_code and b.tenant_code=$P{tenant_code} and (ld.value_date>=$P{from_date} and ld.value_date<=$P{to_date}))
union all (SELECT ld.value_date,ah.customer_id,ld.account_id,ld.transaction_id,ld.amount_magnitude, 'Disbursed' as description, ap.product_code as Product,ap.account_name as Product_name, b.branch_name as Branch_name,b.branch_code as Branch_Code FROM loan_od_disbursements ld ,account_profiles ap , account_holders ah,branches b where ld.tenant_code=ap.tenant_code and ah.holder_num = 1 and  ld.account_id=ap.account_id and ap.tenant_code=ah.tenant_code and ap.account_id=ah.account_id and ah.tenant_code=b.tenant_code and ap.branch_code=b.branch_code and ap.tenant_code=b.tenant_code and b.tenant_code=$P{tenant_code} and (ld.value_date>=$P{from_date} and ld.value_date<=$P{to_date}))
order by Date, Branch_Code,Product,Account_No;]]>
	</queryString>
