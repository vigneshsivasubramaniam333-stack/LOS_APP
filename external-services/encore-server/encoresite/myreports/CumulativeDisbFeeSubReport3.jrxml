	<parameter name="account_id" class="java.lang.String"/>
	<parameter name="charged_value_date" class="java.sql.Date"/>
	<queryString>
		<![CDATA[select sum(f.gross_amount_magnitude) as grossAmount 
from fees f,loan_od_products p,account_profiles ap, enumerations en where 
f.tenant_code=p.tenant_code and f.tenant_code=en.tenant_code and p.tenant_code=ap.tenant_code and f.account_id=ap.account_id and 
p.product_code=ap.product_code and en.reference='3' and en.classifier='FeeName' and 
f.fee_category=en.name and f.account_id=$P{account_id} and f.charged_value_date=$P{charged_value_date}
group by f.account_id,en.name]]>
	</queryString>
	<field name="grossAmount" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="grossAmount"/>
	</field>
