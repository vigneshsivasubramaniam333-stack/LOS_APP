<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.6.0.final using JasperReports Library version 6.6.0  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PortfolioCuts" pageWidth="3650" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="3650" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="3815c149-02bf-4526-b62c-3c2a5861e783">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[Branch Code]]></parameterDescription>
	</parameter>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[select b.branch_name,ah.account_id, ap.account_name as product_description,
c.sector, c.residence_type,
concat(COALESCE(ah.first_name,''),' ',COALESCE(ah.middle_name,''),' ',COALESCE(ah.last_name,'')) as customer_name, ah.customer_id,ap.operational_status,
c.date_of_birth, ifnull(c.religion,'N/A') as religion,
case when c.gender='F' then 'Female' 
when c.gender='M' then 'Male' END as gender,
concat(COALESCE(ah.address1,''),' ',COALESCE(ah.address2,'')) as address1,c.religion,ifnull(c.phone1,'N/A') as phone1,
ifnull(lp.udf_text9,'') as LTV,ifnull(lp.udf_text10,'') as LoanPurpose,ifnull(lp.udf_text11,'') as AnnualTurnover,
case when ah.city_code='VLR' then 'Vellore' 
when ah.city_code='SLS' then 'Salem South' 
when ah.city_code='SLN' then 'Salem North ' 
when ah.city_code='ABR' then 'Ambur' 
when ah.city_code='TVM' then 'Tiruvannamalai' 
when ah.city_code='KLK' then 'Kallakurichi' 
when ah.city_code='TVL' then 'Tiruvallur'
when ah.city_code='PRT' then 'Panruti'
when ah.city_code='CHN' then 'Chennai'
when ah.city_code='KRG' then 'Krishnagiri' 
when ah.city_code='TPT' then 'Tirupathi' END AS city_code,
case when ah.state_code='11' then 'Tamil Nadu' 
when ah.state_code='12' then 'Andhra Pradesh'END AS state_code,
case when ah.district_code='VLR' then 'Vellore' 
when ah.district_code='SLS' then 'Salem South' 
when ah.district_code='SLN' then 'Salem North ' 
when ah.district_code='ABR' then 'Ambur' 
when ah.district_code='TVM' then 'Tiruvannamalai' 
when ah.district_code='KLK' then 'Kallakurichi' 
when ah.district_code='TVL' then 'Tiruvallur'
when ah.district_code='PRT' then 'Panruti'
when ah.district_code='CHN' then 'Chennai'
when ah.district_code='KRG' then 'Krishnagiri' 
when ah.district_code='TPT' then 'Tirupathi' 
else 'N/A' END AS district_code,
case when c.document_type1='PAN' then c.document_number1
when c.document_type2='PAN' then c.document_number2 
when c.document_type3='PAN' then c.document_number3 
else 'N/A' END as PAN,
ap.branch_code,
case when lp.udf_text7 is NOT NULL then round(abs(ifnull(lp.udf_text7,'0')-lw.num_satisfied_demands),0) 
else (lp.tenure_months-lw.num_satisfied_demands) end as balanceEMI,
lp.amount_magnitude, concat(format(lp.normal_interest_rate*100,0),'%') as normal_interest_rate, lp.tenure_months,
ifnull(lp.udf_text2,'') as udf_text2, ifnull(lp.udf_text3,'') as udf_text3, ifnull(lp.udf_text4,'') as udf_text4, ifnull(lp.udf_text5,'') as udf_text5, 
ifnull(lp.udf_text6,'') as udf_text6,ifnull(lp.udf_text7,'') as TenureBeforeMoratorium, lw.installment_amount_magnitude,
lw.first_disbursement_date as first_disbursement_date,lw.first_disbursement_date as first_disbursement_date1,
ifnull(cs.type,'') as type, abs(ab.balance_magnitude) as balance_magnitude
from branchset_branches bs, branches b, account_profiles ap,
account_holders ah, loan_od_profiles lp, loan_od_working_registers lw,
loan_od_disbursements ld, account_balances ab, customers c left join  customer_collaterals cs on(c.customer_id=cs.customer_id and c.tenant_code=cs.tenant_code
and cs.value_magnitude= (select max(value_magnitude) from customer_collaterals css where cs.customer_id=css.customer_id))
where
bs.branch_code=ap.branch_code and ap.branch_code=b.branch_code and c.customer_id=ah.customer_id and ap.product_type='Loans'
and
c.tenant_code=bs.tenant_code and bs.tenant_code=b.tenant_code and ap.tenant_code=ah.tenant_code
and ah.tenant_code=lp.tenant_code and lp.tenant_code=lw.tenant_code and lw.tenant_code=ld.tenant_code and ld.tenant_code=ab.tenant_code and
ap.account_id=ah.account_id and ah.account_id=lp.account_id and lp.account_id=lw.account_id
and lw.account_id=ld.account_id and ld.account_id=ab.account_id and  ah.holder_num=1  and ld.sequence_num=1 and
bs.branchset_code= $P{branchset_code_select} and bs.tenant_code= $P{tenant_code} and  (ld.value_date>=$P{from_date} and ld.value_date<=$P{to_date})]]>
	</queryString>
