	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT bk.current_working_date ,ap.branch_code,lp.guarantor_customer_id1, concat(c.first_name,' ',c.middle_name,' ',c.last_name) as guarantorName, sum(lp.amount_magnitude),sum(ab.balance_magnitude) FROM
loan_od_profiles lp, account_balances ab, account_profiles ap, customers c, banks bk where  ab.tenant_code=lp.tenant_code and ab.tenant_code=bk.tenant_code and
 ap.tenant_code=lp.tenant_code and  ab.tenant_code=c.tenant_code and c.tenant_code=$P{tenant_code} and
lp.account_id=ab.account_id and lp.account_id=ap.account_id
and lp.guarantor_customer_id1=c.customer_id group by lp.guarantor_customer_id1]]>
	</queryString>
	<field name="current_working_date" class="java.sql.Date"/>
	<field name="branch_code" class="java.lang.String"/>
	<field name="guarantor_customer_id" class="java.lang.String"/>
	<field name="guarantorName" class="java.lang.String"/>
	<field name="sum(lp.amount_magnitude)" class="java.math.BigDecimal"/>
	<field name="sum(ab.balance_magnitude)" class="java.math.BigDecimal"/>
