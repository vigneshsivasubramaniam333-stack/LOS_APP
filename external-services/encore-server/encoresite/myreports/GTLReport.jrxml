<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GTLReport" language="groovy" pageWidth="3200" pageHeight="842" columnWidth="3200" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="3b05ac90-d21f-4a56-b70d-32867f450a2d">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[select ld.account_id,ld.value_date,c.account_holder_name1,
concat(c.father_or_spouse_first_name,' ',c.father_or_spouse_middle_name,' ',c.father_or_spouse_last_name) as fatherOrSpouseName,
concat(c.address1,' ',c.address2,' ',c.address3,' ',c.city_code,' ',c.state_code,' ',c.country_code,' ',c.pin_code) as address,
c.gender,c.date_of_birth,c.occupation,c.annual_income,c.document_type1,
concat(n.first_name,' ',n.middle_name,' ',n.last_name) as nomineeName,c.nominee_relationship_type,
f.gross_amount_magnitude ,n.date_of_birth as  nomineeDOB,ld.amount_magnitude,lp.normal_interest_rate,ap.branch_code,br.branch_name,lp.tenure_months,
case when lp.tenure_unit=2 then 'Weekly' when lp.tenure_unit=3 then 'Fortnightly' when
lp.tenure_unit=4 then 'Monthly' else 'Quarterly' end as frequency,TIMESTAMPDIFF(YEAR,c.date_of_birth,br.current_working_date) AS age,lp.amount_magnitude as loanAmount
 from account_holders ah, loan_od_disbursements ld, customers c left join customers n on
(c.tenant_code = n.tenant_code and c.nominee_customer_id = n.customer_id), fees f,
loan_od_profiles lp, account_profiles ap,branches br
where ah.tenant_code=ld.tenant_code and c.tenant_code=ah.tenant_code and ah.tenant_code=f.tenant_code
and ah.tenant_code=lp.tenant_code and c.tenant_code=ap.tenant_code and ah.tenant_code=br.tenant_code
and ld.account_id=ah.account_id and ah.customer_id=c.customer_id and ld.account_id=f.account_id
and lp.account_id=ld.account_id and ld.account_id=ap.account_id and ap.branch_code=br.branch_code
and f.fee_description='Life Insurance' and ah.tenant_code=$P{tenant_code} and ld.value_date >= $P{from_date} and ld.value_date <= $P{to_date}]]>
	</queryString>
