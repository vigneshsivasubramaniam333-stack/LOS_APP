	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[As On Date]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT p.product_code,p.product_description,case when lp.repayment_method=0 then "Bullet" when lp.repayment_method=1 then "Equated" when lp.repayment_method=2 then "Overdraft" end as Type, 
concat(round((lp.normal_interest_rate*100),0),'%') as normal_interest_rate,concat(round((lp.penal_interest_rate*100),0),'%') as penal_interest_rate,
lp.amount_lower_magnitude as MinAmount,lp.amount_upper_magnitude as MaxAmount,
case when lp.tenure_lower_unit=1 then lp.tenure_lower_days when lp.tenure_lower_unit=2 then ROUND(lp.tenure_lower_days/7) when lp.tenure_lower_unit=3 then ROUND(lp.tenure_lower_days/14)
when lp.tenure_lower_unit=4 then (lp.tenure_lower_months) when lp.tenure_lower_unit=5 then ROUND(lp.tenure_lower_months/4) when lp.tenure_lower_unit=6 then ROUND(lp.tenure_lower_months/6)
when lp.tenure_lower_unit=7 then ROUND(lp.tenure_lower_months/12) end as MinTenure,
case when lp.tenure_upper_unit=1 then lp.tenure_upper_days when lp.tenure_upper_unit=2 then ROUND(lp.tenure_upper_days/7) when lp.tenure_upper_unit=3 then ROUND(lp.tenure_upper_days/14)
when lp.tenure_upper_unit=4 then (lp.tenure_upper_months) when lp.tenure_upper_unit=5 then ROUND(lp.tenure_upper_months/4) when lp.tenure_upper_unit=6 then ROUND(lp.tenure_upper_months/6)
when lp.tenure_upper_unit=7 then ROUND(lp.tenure_upper_months/12) end as MaxTenure,
case when lp.tenure_lower_unit=7 then "YEAR" when lp.tenure_lower_unit=6 then "HALF YEAR" when lp.tenure_lower_unit=5 then "QUARTER" when lp.tenure_lower_unit=4 then "MONTH" when lp.tenure_lower_unit=3 then "FORTNIGHT" when lp.tenure_lower_unit=2 then "WEEK" when lp.tenure_lower_unit=1 then "DAY" end as time_unit,
p.effective_date, p.expiry_date
FROM loan_od_products lp,products p where p.tenant_code=lp.tenant_code and p.product_type=lp.product_type
 and p.product_code=lp.product_code and
p.effective_date<=$P{from_date} and p.expiry_date>=$P{from_date} and p.tenant_code=$P{tenant_code}]]>
	</queryString>
