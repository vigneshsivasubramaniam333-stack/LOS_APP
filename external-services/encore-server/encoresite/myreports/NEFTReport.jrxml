	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[select ld.account_id,c.account_holder_name1,c.bank_name1,c.branch_name1,c.ifsc_code1,ld.amount_magnitude,
case when f.fee_description='Personal Accident Insurance' then f.gross_amount_magnitude else 0 end as PAI,
case when f.fee_description='Life Insurance' then f.gross_amount_magnitude else 0 end as GTL,
case when f.fee_description='Processing Fee' then f.gross_amount_magnitude else 0 end as ProcessingFee,
case when f.fee_description='Cattle Insurance' then f.gross_amount_magnitude else 0 end as CattleInsurance,
case when f.fee_description='Adhoc Fee' then f.gross_amount_magnitude else 0 end as AdhocFee
 from account_holders ah, loan_od_disbursements ld, customers c, fees f
where ah.tenant_code=ld.tenant_code and c.tenant_code=ah.tenant_code and ah.tenant_code=f.tenant_code
and ld.account_id=ah.account_id and ah.customer_id=c.customer_id and ld.account_id=f.account_id
 and ah.tenant_code=$P{tenant_code} and ld.value_date >= $P{from_date} and ld.value_date <= $P{to_date} ]]>
	</queryString>
	<field name="account_id" class="java.lang.String"/>
