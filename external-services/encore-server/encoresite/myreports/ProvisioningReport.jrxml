	<queryString>
		<![CDATA[select lp.account_id,lp.asset_category,lp.old_asset_category,lp.value_date,lp.transaction_date,
lp.old_provisioning_date,lp.days_past_due,lp.balance_magnitude,lp.old_total_provisioned_amount_magnitude,
lp.total_provisioned_amount_magnitude,lp.user_id
