<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="NormalInterestBookingTransactionsReport" language="groovy" pageWidth="640" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="640" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="135e4acb-b217-4b84-9397-0af3a3a1258c">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[Branchset Code]]></parameterDescription>
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select ic.account_id,ap.branch_code,ap.product_code,ic.computation_date,ic.interest_rate,
sum(ic.interest_magnitude),case when ic.interest_type=0 then 'Normal Interest' end as interest_type
FROM interest_computations ic ,account_profiles ap, branchset_branches bs
where ic.tenant_code=ap.tenant_code and ic.tenant_code=bs.tenant_code and ic.account_id=ap.account_id and ap.branch_code=bs.branch_code and bs.branchset_code =$P{branchset_code_select}
and ic.tenant_code=$P{tenant_code}
and (ic.computation_date>=$P{from_date} and ic.computation_date<=$P{to_date}) and ic.interest_type=0 group by ic.account_id]]>
	</queryString>
	<field name="account_id" class="java.lang.String"/>
	<field name="branch_code" class="java.lang.String"/>
	<field name="product_code" class="java.lang.String"/>
	<field name="computation_date" class="java.sql.Date"/>
	<field name="interest_rate" class="java.math.BigDecimal"/>
	<field name="sum(ic.interest_magnitude)" class="java.math.BigDecimal"/>
	<field name="interest_type" class="java.lang.String"/>
