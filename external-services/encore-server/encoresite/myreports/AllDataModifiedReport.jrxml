	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="imagePath" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{imagePath}.split( "images" )[0]+"myreports/"]]></defaultValueExpression>
