<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PAIReport" language="groovy" pageWidth="1850" pageHeight="842" columnWidth="1850" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="633cb402-2d72-4f2e-9439-1ff625f674a3">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="532"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[select ld.account_id,ld.value_date,c.account_holder_name1,
concat(c.father_or_spouse_first_name,' ',c.father_or_spouse_middle_name,' ',c.father_or_spouse_last_name) as fatherOrSpouseName,
concat(c.address1,' ',c.address2,' ',c.address3,' ',c.city_code,' ',c.state_code,' ',c.country_code,' ',c.pin_code) as address,
c.gender,c.date_of_birth,c.occupation,concat(n.first_name,' ',n.middle_name,' ',n.last_name) as nomineeName,c.nominee_relationship_type,f.gross_amount_magnitude,TIMESTAMPDIFF(YEAR,c.date_of_birth,b.current_working_date) AS age,lp.amount_magnitude as loanAmount
 from account_holders ah, loan_od_disbursements ld,loan_od_profiles lp, customers c left join customers n on
(c.tenant_code = n.tenant_code and c.nominee_customer_id = n.customer_id), fees f,banks b
where ah.tenant_code=b.tenant_code and ah.tenant_code=ld.tenant_code and ah.tenant_code=lp.tenant_code and c.tenant_code=ah.tenant_code and ah.tenant_code=f.tenant_code
and ld.account_id=ah.account_id and ah.customer_id=c.customer_id and ld.account_id=f.account_id
and ld.account_id=lp.account_id
and f.fee_description='Personal Accident Insurance' and ah.tenant_code=$P{tenant_code} and ld.value_date >= $P{from_date} and ld.value_date <= $P{to_date}]]>
	</queryString>
	<field name="account_id" class="java.lang.String"/>
	<field name="value_date" class="java.sql.Date"/>
