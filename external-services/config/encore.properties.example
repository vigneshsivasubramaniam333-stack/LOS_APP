# Legacy-style Encore properties (reference)
# Map these to Spring Boot env / los.lms.encore.* in lms-adapter-service (see application.yml).
# Vendor Encore server (official) reads its own config under external-services/encore-server/encoresite/conf/.

encore.encoreAddress=http://10.0.1.7:8090/encore/
encore.encoreKeyStoreFilePath=/vol/software/apache-tomcat/keystore
encore.encoreKeyStorePassword=test1234
encore.deposit=Deposit
encore.withdraw=Withdrawal
encore.fundsTransfer=FundsTransfer
encore.investmentAccountId=000010000001
encore.ngoFundAccountId=000010000002
encore.kivaAccountId=000010000069
encore.currency=INR
encore.pincode=123456
encore.accountactivestatus=active
encore.credit=CREDIT
encore.debit=DEBIT

encore.casaaccountbranchcode=HQ
encore.casaacountproductCode=C100

encore.schema=http
encore.hostname=10.0.1.7
encore.encorePort=8090
encore.apiusername=billiontech
encore.apipassword=billionTech@encore25

encore.admin.branch=HQ
encore.cashaccount=Internal:Cash
encore.ibrdueto=Internal:IbrDueTo
encore.ibrduefrom=Internal:IbrDueFrom
encore.interestincome=IntInc
encore.feeincome=Internal:FeeInc
encore.feecollection=Internal:FeeColl
encore.producttype=Internal
encore.feereceivable=Internal:FeeRcv

encore.loanaccountmigrated=false
encore.loanminpenalinterestrate=1
encore.loanpenalinterestrate=2
encore.loanmaxpenalinterestrate=4
encore.loanproducttype=Loans
encore.loantenureunitmonthly=Month
encore.loantenureunitquarterly=Quarter
encore.loantenureunithalfyearly=Half Year
encore.loantenureunityearly=Year
encore.loantenureunitweekly=Week
encore.loantenureunitday=Day

encore.product.mindate=2010-01-01
encore.product.maxdate=2025-01-01
encore.product.minAmount=100
encore.product.maxAmount=5000000
encore.product.tenure.magnitude.min=1
encore.product.tolerance=1
encore.product.repayment.method.equated=Equated
encore.product.repayment.method.bullet=Bullet
encore.product.postmaturitynormal.interestrate=24
encore.product.postmaturity.demandinterval=1 Day
encore.product.moratoriumperiodmagnitude=0
encore.product.moratoriumperiodunit=Month
encore.product.moratoriumtype=None
encore.product.disbursementfeecomputationrulecode=FCR2
encore.product.interestcomputationmethod=SCHEDULE_BALANCE
encore.product.interestcomputationmethod.bullet=EOD_BALANCE

encore.product.repayment.method.bullet.total=Bullet
encore.product.interestcomputationmethod.bullet.total=Total Interest
encore.product.repayment.method.bullet.periodic=Bullet
encore.product.interestcomputationmethod.bullet.periodic=Periodic Interest

encore.api.encoreWorkingDate=webservices/loans/accounts/findBankWorkingDate
encore.api.createProduct=webservices/v2/createLoanProduct
encore.api.createloanaccount=webservices/loans/accounts/openAccount
encore.api.postTransactions=webservices/loans/accounts/postTransactions
encore.api.reversetransaction=webservices/loans/accounts/reverseTransactions
encore.api.findsummaries=webservices/loans/accounts/findSummaries
encore.api.findaccounts=webservices/loans/accounts/findLoanOdAccounts
encore.api.getPrecloseAmtByValueDt=webservices/loans/accounts/findPreclosureAmountAsOfDate
encore.api.findODProductInfo=webservices/loans/accounts/findLoanOdProduct
encore.api.findPreOpenSummary=webservices/findPreOpenSummary
encore.api.findLoanInfo=webservices/findLoanInfo
