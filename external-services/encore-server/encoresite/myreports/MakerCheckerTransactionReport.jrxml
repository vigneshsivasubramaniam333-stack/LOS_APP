	<parameter name="instrument_select" class="java.lang.String">
		<parameterDescription><![CDATA[Instrument]]></parameterDescription>
	</parameter>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To date]]></parameterDescription>
	</parameter>
	<parameter name="action_type_select" class="java.lang.String">
		<parameterDescription><![CDATA[Action Type]]></parameterDescription>
	</parameter>
	<parameter name="status_select" class="java.lang.String">
		<parameterDescription><![CDATA[Status]]></parameterDescription>
	</parameter>
	<parameter name="user_select" class="java.lang.String">
		<parameterDescription><![CDATA[User]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[select account_id,transaction_id,transaction_name,
instrument,action_type,case when status=0 then 'PENDING' 
when status=1 then 'APPROVED' else 'REJECTED' end as status ,amount_magnitude,
value_date,checked_date, checked_by 
from maker_checker_transactions where
tenant_code= $P{tenant_code} and 
(instrument=$P{instrument_select} or $P{instrument_select}='' or $P{instrument_select} is null) and 
(status= $P{status_select} or $P{status_select}='' or $P{status_select} is null) and 
(action_type= $P{action_type_select} or $P{action_type_select}='' or $P{action_type_select} is null) and 
(value_date >= $P{from_date}  and value_date <= $P{to_date}) and 
(created_by= $P{user_select} or checked_by= $P{user_select} )]]>
	</queryString>
