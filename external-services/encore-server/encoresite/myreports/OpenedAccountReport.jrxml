	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[Branchset Code]]></parameterDescription>
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[select lp.account_id,lp.amount_magnitude,case when
lp.tenure_unit=4 then lp.tenure_months when lp.tenure_unit=2 then ROUND(lp.tenure_days/7)
when lp.tenure_unit=7 then ROUND(lp.tenure_months/12) end as tenure,case when
lp.tenure_unit=4 then 'MONTH' when lp.tenure_unit=2 then 'WEEK' when lp.tenure_unit=7 then
'YEAR' end as time_unit,ap.product_code,ap.branch_code,c.customer_id,
c.first_name,c.middle_name, c.last_name,c.bank_name1,c.branch_name1,c.ifsc_code1,
c.micr_code1,c.account_number1,c.account_holder_name1,c.sector from customers c, loan_od_profiles lp, account_profiles ap, account_holders ah, branches b, branchset_branches bs where
c.tenant_code=lp.tenant_code and lp.tenant_code=ap.tenant_code and ap.tenant_code=b.tenant_code and b.tenant_code=bs.tenant_code and ap.tenant_code=ah.tenant_code
and c.customer_id=ah.customer_id and lp.account_id=ah.account_id and ap.account_id=lp.account_id
and ah.holder_num=1 and ap.branch_code=b.branch_code and b.branch_code=bs.branch_code and c.tenant_code=$P{tenant_code} and bs.branchset_code=$P{branchset_code_select} and ap.opened_on_value_date>=$P{from_date} and ap.opened_on_value_date<=$P{to_date}]]>
	</queryString>
