	<field name="repayment_num" class="java.lang.Integer"/>
	<field name="branch_name" class="java.lang.String"/>
	<field name="transaction_id" class="java.lang.String"/>
	<field name="account_id" class="java.lang.String"/>
	<field name="amount_magnitude" class="java.math.BigDecimal"/>
	<field name="transaction_date" class="java.sql.Date"/>
	<field name="customerName" class="java.lang.String"/>
	<field name="bank_name" class="java.lang.String"/>
