		<parameterDescription><![CDATA[TransactionId]]></parameterDescription>
	</parameter>
	<parameter name="imagePath" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT bk.bank_name,ld.account_id,ah.customer_id,concat(ah.first_name," ",middle_name," ",last_name) as customerName,
b.branch_name,ld.value_date,ld.transaction_date,ld.amount_magnitude,
ld.transaction_id,ld.tenant_code,ld.sequence_num, DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) as currentDate
FROM loan_od_disbursements ld ,account_profiles ap ,account_holders ah,branches b,banks bk where b.tenant_code=bk.tenant_code and b.tenant_code=ap.tenant_code and
ld.tenant_code=ap.tenant_code and ap.tenant_code=ah.tenant_code and b.branch_code=ap.branch_code and ap.account_id=ah.account_id and ah.holder_num=1 
and ld.account_id=ap.account_id and ap.tenant_code=$P{tenant_code} and ld.transaction_id=$P{transactionId_text}]]>
	</queryString>
	<field name="bank_name" class="java.lang.String"/>
