	<subDataset name="Empty Dataset1" uuid="3714f584-85c5-4ed0-aa6c-d7568c89ce85">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="232"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="763"/>
		<parameter name="NetProfit" class="java.math.BigDecimal"/>
		<parameter name="branchset_code_select" class="java.lang.String"/>
		<parameter name="tenant_code" class="java.lang.String"/>
		<queryString>
			<![CDATA[select p.gl_subhead, p.product_code,p.category,sum(-ab.balance_magnitude) as balance
from account_balances ab, account_profiles ap , products p, branchset_branches bsb
where ab.account_id = ap.account_id and ab.tenant_code = ap.tenant_code and ab.tenant_code = $P{tenant_code}
and p.product_code=ap.product_code and p.tenant_code=ap.tenant_code and p.category='Expense'  
and ap.tenant_code = bsb.tenant_code and ap.branch_code = bsb.branch_code and bsb.branchset_code=$P{branchset_code_select}
group by p.gl_subhead,p.product_code,p.category having balance<>0]]>
		</queryString>
		<field name="gl_subhead" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="gl_subhead"/>
			<property name="com.jaspersoft.studio.field.label" value="gl_subhead"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="account_profiles"/>
		</field>
		<field name="balance" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="balance"/>
			<property name="com.jaspersoft.studio.field.label" value="balance"/>
		</field>
		<field name="category" class="java.lang.String"/>
		<variable name="Expensesum" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{balance}]]></variableExpression>
		</variable>
		<variable name="balance1" class="java.lang.Double" resetType="Group" resetGroup="Group1" calculation="Sum">
			<variableExpression><![CDATA[$F{balance}]]></variableExpression>
		</variable>
		<group name="Group1">
			<groupExpression><![CDATA[$F{gl_subhead}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="Dataset1" uuid="3a117433-2d1b-4d95-83cd-56942f869aff">
