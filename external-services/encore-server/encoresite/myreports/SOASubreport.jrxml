<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SOASubreport" pageWidth="1066" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="1066" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="41b64d55-09ce-4c0c-ac65-efaa2ad105ad">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="accountId_text" class="java.lang.String"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select * from (select '1' as id, created_at, 'Disbursement' as transaction_type,transaction_date, value_date, balance_magnitude, amount_magnitude as total_debit, ' ' as total_credit
from loan_od_disbursements where tenant_code=$P{tenant_code} and account_id=$P{accountId_text}
UNION ALL
select '2' as id, created_at, 'Demand' as transaction_type, demand_date as transaction_date, demand_date as value_date, '' as balance_magnitude, principal_magnitude+normal_interest_magnitude as total_debit, '' as total_credit
from loan_od_demands where tenant_code=$P{tenant_code} and account_id=$P{accountId_text}
UNION ALL
select '3' as id, created_at, case when repayment_type=0 then 'Scheduled Repayment' when repayment_type=1 then 'Advanced Repayment' 
when repayment_type=2 and description like 'Ex-Gratia Credit%'  then 'Prepayment Ex-Gratia' when repayment_type=2 then 'Prepayment' 
else 'Preclosure' end as transaction_type, transaction_date, value_date, balance_magnitude, ' ' as total_debit, amount_magnitude as total_credit
from loan_od_repayments where tenant_code=$P{tenant_code} and account_id=$P{accountId_text}
UNION ALL
select '4' as id, created_at, concat('Fee Charge', '-', fee_description) as transaction_type, charged_transaction_date as transaction_date, charged_value_date as value_date,'' as balance_magnitude,
gross_amount_magnitude as total_debit, ' ' as total_credit 
from fees where tenant_code=$P{tenant_code} and account_id=$P{accountId_text} and fee_description !='Late payment charges'
UNION ALL
select '5' as id, created_at, 'Fee Payment' as transaction_type, payment_transaction_date as transaction_date, payment_value_date as value_date,'' as balance_magnitude,
' ' as total_debit, paid_amount_magnitude as total_credit
from fee_payments where tenant_code=$P{tenant_code} and account_id=$P{accountId_text}
UNION ALL
select '6' as id, created_at, 
case when write_off_transaction_type=0 then 'WRITEOFF' 
when write_off_transaction_type=1 then 'RECOVERY' 
when write_off_transaction_type=2 then 'FULL_SETTLEMENT'
when write_off_transaction_type=3 then 'SETTLEMENT'
else 'INTERNAL_PRECLOSURE' end as transaction_type, transaction_date , value_date, balance_magnitude,  ' ' as total_debit, amount_magnitude as total_credit 
from loan_od_write_offs where tenant_code=$P{tenant_code} and account_id=$P{accountId_text}
UNION ALL
select '7' as id, created_at, transaction_name as transaction_type, transaction_date , value_date, gross_amount_magnitude as balance_magnitude,amount_magnitude as total_debit, ' ' as total_credit
from general_transactions where tenant_code=$P{tenant_code} and account_id=$P{accountId_text}
UNION ALL
select '8' as id, created_at, 
case when asset_category='WriteOff' then 'WriteOff' 
when asset_category='Standard' then 'Standard' 
else 'Substandard' end as transaction_type, 
 transaction_date , value_date, balance_magnitude, total_provisioned_amount_magnitude as total_debit, ' ' as total_credit
from loan_od_provisioning where tenant_code=$P{tenant_code} and account_id=$P{accountId_text}
UNION ALL
select '9' as id, created_at, 'Capitalized Interest' as transaction_type, transaction_date, 
case 
when tenure_unit = 1 then date_add(value_date, interval tenure_days DAY) 
when tenure_unit = 4 then date_add(value_date, interval tenure_months MONTH)
end as value_date,
'' as balance_magnitude, capitalized_interest_magnitude as total_debit, '' as total_credit
from loan_od_moratoriums where moratorium_type='4' and tenant_code=$P{tenant_code} and account_id=$P{accountId_text}) as t1 order by value_date,created_at,id;]]>
	</queryString>
	<field name="value_date" class="java.lang.String"/>
	<field name="balance_magnitude" class="java.lang.String"/>
	<field name="total_debit" class="java.lang.String"/>
	<field name="transaction_type" class="java.lang.String"/>
	<field name="total_credit" class="java.lang.String"/>
