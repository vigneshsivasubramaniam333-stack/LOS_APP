	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ah.customer_id,concat(COALESCE(ah.first_name,''),(case when COALESCE(ah.middle_name,'')='' then '' else (concat(' ',COALESCE(ah.middle_name,''))) end),' ',COALESCE(ah.last_name,'')) as customerName,
c.loan_limit_magnitude as LimitMagnitude,lw.total_principal_due_magnitude as OverallOutstandingofthecustomer,ab.balance_magnitude as LimitUtilized
from loan_od_working_registers lw,account_balances ab,account_holders ah,customers c
where ab.account_id=lw.account_id and ah.account_id=ab.account_id 
and ab.tenant_code=ah.tenant_code and ab.tenant_code=lw.tenant_code and ah.tenant_code=c.tenant_code and ab.tenant_code= $P{tenant_code}]]>
	</queryString>
	<field name="customer_id" class="java.lang.String"/>
	<field name="customerName" class="java.lang.String"/>
	<field name="LimitMagnitude" class="java.math.BigDecimal"/>
	<field name="OverallOutstandingofthecustomer" class="java.math.BigDecimal"/>
	<field name="LimitUtilized" class="java.math.BigDecimal"/>
