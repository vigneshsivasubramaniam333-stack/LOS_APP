	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date Preceding]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date Preceding]]></parameterDescription>
	</parameter>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select h.gstin, concat(COALESCE(c.first_name,''),' ',COALESCE(c.middle_name,''),' ',COALESCE(c.last_name,'')) as customerName,
 h.state_code,concat(COALESCE(c.address1,''),',',COALESCE(c.address2,''),',',COALESCE(c.address3,''),',',
 COALESCE(c.city_code,''),',',COALESCE(c.state_code,''),' - ',COALESCE(c.pin_code,''),' ')  as address,
 d.penal_interest_magnitude ,d.amount_magnitude,d.demand_date,
 d.account_id,d.demand_num,b.state_code as bankStateCode,s.state_name as customerStateName,concat(COALESCE(b.address1,''),',',COALESCE(b.address2,''),',',COALESCE(b.address3,''),',',
 COALESCE(b.city_code,''),',',COALESCE(b.state_code,''),' - ',COALESCE(b.pin_code,'')) as bankAddress,
 b.registered_bank_name,b.gstin as bankGstin
from loan_od_demands d, account_holders h, customers c, banks b,tax_rates t,states s where d.tenant_code=h.tenant_code and d.tenant_code=t.tenant_code and 
d.tenant_code=c.tenant_code and d.tenant_code=b.tenant_code and c.tenant_code=s.tenant_code and c.state_code=s.state_code 
and d.account_id=h.account_id and h.customer_id=c.customer_id and d.scheduled_demand=0 
and d.demand_date>=t.effective_date and d.demand_date<=t.expiry_date  and 
d.demand_date>=$P{from_date} and d.demand_date<=$P{to_date}  and d.tenant_code=$P{tenant_code}]]>
	</queryString>
