<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DisbursementReportOption1" language="groovy" pageWidth="2600" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="2600" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="f238e559-3c9c-4989-bb60-28250435826f">
	<property name="ireport.zoom" value="1.0"/>
