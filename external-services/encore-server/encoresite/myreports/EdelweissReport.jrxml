<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EdelweissReport" language="groovy" pageWidth="1510" pageHeight="842" whenNoDataType="BlankPage" columnWidth="1510" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="dfaf00c5-0bba-4ec7-80c9-307286b82d7c">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[(SELECT bk.current_working_date,sum( (normal_interest_magnitude+normal_interest_adjustment_magnitude+penal_interest_magnitude+penal_interest_adjustment_magnitude) )as NormalInterest,gl_subhead, account_name,product_code,'RCV_CR' as type   FROM loan_od_repayments ld ,account_profiles ap ,account_holders ah, branchset_branches bs,banks bk
where  ld.tenant_code=bk.tenant_code and ld.tenant_code=ap.tenant_code and ap.tenant_code=ah.tenant_code and   ah.tenant_code=bs.tenant_code and ap.account_id=ah.account_id and
 ah.holder_num=1 and  ld.account_id=ap.account_id and ap.branch_code=bs.branch_code and ap.tenant_code=$P{tenant_code} and   bs.branchset_code ='EDELWEISS' and (ld.value_date>=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) and ld.value_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY)) group by ap.product_code)
union all
(select bk.current_working_date,sum(w.total_normal_interest_due_magnitude) as total_int_due ,gl_subhead, account_name,p.product_code,'int_over_due' as type
 from branchset_branches bs, banks bk,account_balances b,loan_od_profiles lp,account_holders ah,account_profiles p,loan_od_working_registers w
 left join loan_od_demands d on ( w.tenant_code = d.tenant_code and w.account_id = d.account_id
and w.oldest_due_demand_num = d.demand_num)
left join loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id)
where p.tenant_code=bs.tenant_code and
w.account_id = b.account_id and w.tenant_code = b.tenant_code and w.account_id = p.account_id
and w.tenant_code = b.tenant_code and w.account_id = p.account_id and
w.tenant_code = p.tenant_code and lp.tenant_code=p.tenant_code and lp.account_id=p.account_id
and ah.tenant_code=p.tenant_code and ah.account_id=p.account_id and
 ah.holder_num=1
and p.tenant_code=w.tenant_code and
p.account_id=w.account_id and bs.branchset_code ='EDELWEISS' and
p.branch_code=bs.branch_code and bk.tenant_code = b.tenant_code
and (p.operational_status=0 or p.closed_on_transaction_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) or p.operational_status=3) and w.tenant_code = 'KGFS' and datediff(bk.current_working_date, d.demand_date)<>0 group by p.product_code)
union all
(Select bk.current_working_date,sum(f.amount_magnitude) as FeeAmount,gl_subhead,
account_name,product_code,'fee_amt' as type   from fees f ,account_profiles ap ,banks bk,
 branchset_branches bs where f.tenant_code=ap.tenant_code and f.tenant_code=bs.tenant_code and bk.tenant_code=ap.tenant_code and
f.account_id=ap.account_id and ap.branch_code=bs.branch_code and bs.branchset_code='EDELWEISS' and f.payment_value_date>=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) and f.payment_value_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) and f.tenant_code=$P{tenant_code} group by ap.product_code)
union all
(Select bk.current_working_date,sum(f.surcharge_magnitude) as Surcharge, gl_subhead,
account_name,product_code,'srg_amt' as type  from fees f ,account_profiles ap ,banks bk,
 branchset_branches bs where f.tenant_code=ap.tenant_code and f.tenant_code=bs.tenant_code and bk.tenant_code=bs.tenant_code and
f.account_id=ap.account_id and ap.branch_code=bs.branch_code and bs.branchset_code='EDELWEISS' and f.payment_value_date>=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) and f.payment_value_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) and f.tenant_code=$P{tenant_code} group by ap.product_code)
union all
(Select bk.current_working_date,sum(f.surcharge_magnitude), gl_subhead,
account_name,product_code,'total_srg_amt' as type  from fees f ,account_profiles ap ,banks bk,
 branchset_branches bs where f.tenant_code=ap.tenant_code and f.tenant_code=bs.tenant_code and f.tenant_code=bk.tenant_code and
f.account_id=ap.account_id and ap.branch_code=bs.branch_code and bs.branchset_code='EDELWEISS'  and f.tenant_code=$P{tenant_code} group by ap.product_code)
union all
(Select bk.current_working_date,sum(w.total_fee_due_magnitude), gl_subhead,
account_name,product_code,'total_fee_due_amt' as type  from loan_od_working_registers w ,account_profiles ap ,banks bk,
 branchset_branches bs where w.tenant_code=ap.tenant_code and w.tenant_code=bs.tenant_code and bk.tenant_code=bs.tenant_code and
w.account_id=ap.account_id and ap.branch_code=bs.branch_code and bs.branchset_code='EDELWEISS'  and w.tenant_code=$P{tenant_code} group by ap.product_code)
union all
(Select bk.current_working_date,sum(f.amount_magnitude) , gl_subhead,
account_name,product_code,'total_amt' as type  from fees f ,account_profiles ap ,banks bk,
 branchset_branches bs where f.tenant_code=ap.tenant_code and f.tenant_code=bs.tenant_code and f.tenant_code=bk.tenant_code and
f.account_id=ap.account_id and ap.branch_code=bs.branch_code and bs.branchset_code='EDELWEISS'  and f.tenant_code=$P{tenant_code} group by ap.product_code)
union all
(SELECT bk.current_working_date,sum( (principal_magnitude+principal_adjustment_magnitude)) as Principal ,gl_subhead, account_name,product_code,'prin_CR' as type FROM loan_od_repayments ld ,account_profiles ap ,account_holders ah, branchset_branches bs,banks bk where ld.tenant_code=ap.tenant_code and bk.tenant_code=bs.tenant_code and ap.tenant_code=ah.tenant_code and  ah.tenant_code=bs.tenant_code and ap.account_id=ah.account_id and  ld.account_id=ap.account_id and
 ah.holder_num=1 and ap.branch_code=bs.branch_code and ap.tenant_code=$P{tenant_code} and bs.branchset_code ='EDELWEISS' and (ld.value_date>=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) and ld.value_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY)) group by product_code)
union all
(select bk.current_working_date,sum(w.total_principal_due_magnitude) as total_prin_due ,gl_subhead, account_name,p.product_code,'prin_over_due' as type
 from branchset_branches bs, banks bk,account_balances b,loan_od_profiles lp,account_holders ah,account_profiles p,loan_od_working_registers w
 left join loan_od_demands d on ( w.tenant_code = d.tenant_code and w.account_id = d.account_id
and w.oldest_due_demand_num = d.demand_num)
left join loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id)
where p.tenant_code=bs.tenant_code and
w.account_id = b.account_id and w.tenant_code = b.tenant_code and w.account_id = p.account_id
and w.tenant_code = b.tenant_code and w.account_id = p.account_id and
w.tenant_code = p.tenant_code and lp.tenant_code=p.tenant_code and lp.account_id=p.account_id
and ah.tenant_code=p.tenant_code and ah.account_id=p.account_id and
 ah.holder_num=1
and bs.branchset_code ='EDELWEISS' and
p.branch_code=bs.branch_code and bk.tenant_code = b.tenant_code
and (p.operational_status=0 or p.closed_on_transaction_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) or p.operational_status=3) and w.tenant_code = $P{tenant_code} and
datediff(bk.current_working_date, d.demand_date)<>0 group by p.product_code)
union all
(SELECT bk.current_working_date,Sum(ld.amount_magnitude),gl_subhead, account_name,ap.product_code,'end_CR' as type FROM loan_od_disbursements ld ,account_profiles ap ,account_holders ah,branches b,branchset_branches bs,banks bk  where bk.tenant_code=bs.tenant_code and ld.tenant_code=ap.tenant_code and ld.tenant_code=bs.tenant_code  and ld.account_id=ap.account_id and ap.tenant_code=ah.tenant_code  and ap.account_id=ah.account_id and ah.tenant_code=b.tenant_code and
 ah.holder_num=1 and ap.branch_code=b.branch_code and ap.branch_code=bs.branch_code and bs.branchset_code ='EDELWEISS'  and ap.tenant_code=$P{tenant_code} and (ld.value_date>=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) and ld.value_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY)) group by ap.product_code)
union all
(SELECT bk.current_working_date,sum(ic.interest_magnitude),gl_subhead, account_name,ap.product_code,'Inc_CR' as type FROM branchset_branches bs, interest_computations ic , account_profiles ap,banks bk
where ic.tenant_code=bs.tenant_code and ic.tenant_code=ap.tenant_code and bk.tenant_code=bs.tenant_code and bs.branchset_code ='EDELWEISS' and
 ap.branch_code=bs.branch_code and
ic.account_id=ap.account_id and ic.tenant_code=$P{tenant_code}
and ic.computation_date >=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) and ic.computation_date <=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) and ic.interest_type=0 group by ap.product_code)
union all
(select bk.current_working_date,sum(w.total_disbursed_magnitude),gl_subhead, account_name,p.product_code,'cash_end' as type
 from branchset_branches bs, banks bk,account_balances b,loan_od_profiles lp,account_holders ah,account_profiles p,loan_od_working_registers w
 left join loan_od_demands d on ( w.tenant_code = d.tenant_code and w.account_id = d.account_id
and w.oldest_due_demand_num = d.demand_num)
left join loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id)
where p.tenant_code=bs.tenant_code and
w.account_id = b.account_id and w.tenant_code = b.tenant_code and w.account_id = p.account_id
and w.tenant_code = b.tenant_code and w.account_id = p.account_id and
w.tenant_code = p.tenant_code and lp.tenant_code=p.tenant_code and lp.account_id=p.account_id
and ah.tenant_code=p.tenant_code and ah.account_id=p.account_id and
 ah.holder_num=1
and bs.branchset_code ='EDELWEISS' and
p.branch_code=bs.branch_code and bk.tenant_code = b.tenant_code
and (p.operational_status=0 or p.closed_on_transaction_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) or p.operational_status=3)
and w.tenant_code = $P{tenant_code} group by p.product_code)
union all
(select bk.current_working_date,sum(w.total_normal_interest_due_magnitude)+
Sum(w.booked_not_due_normal_interest_magnitude)
 ,gl_subhead, account_name,p.product_code,'Int_Accr_end' as type from branchset_branches bs,banks bk,account_balances b,loan_od_profiles lp,account_holders ah,account_profiles p,loan_od_working_registers w
left join loan_od_demands d on ( w.tenant_code = d.tenant_code and
w.account_id = d.account_id and w.oldest_due_demand_num = d.demand_num)
left join loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id) where p.tenant_code=bs.tenant_code and w.account_id = b.account_id and w.tenant_code = b.tenant_code and w.account_id = p.account_id
and w.tenant_code = b.tenant_code and w.account_id = p.account_id and  ah.holder_num=1 and
w.tenant_code = p.tenant_code and lp.tenant_code=p.tenant_code and lp.account_id=p.account_id
and ah.tenant_code=p.tenant_code and ah.account_id=p.account_id and p.branch_code=bs.branch_code and p.tenant_code=w.tenant_code and
p.account_id=w.account_id and bk.tenant_code = b.tenant_code and bs.branchset_code ='EDELWEISS' and
(p.operational_status=0 or p.closed_on_transaction_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) or p.operational_status=3) and w.tenant_code = $P{tenant_code} group by p.product_code)
union all
(select bk.current_working_date,Sum(b.balance_magnitude) as bal ,gl_subhead, account_name,p.product_code,'Prin_end' as type
from branchset_branches bs,banks bk,account_balances b,loan_od_profiles lp,account_holders ah,account_profiles p,loan_od_working_registers w
left join loan_od_demands d on ( w.tenant_code = d.tenant_code and w.account_id = d.account_id
and w.oldest_due_demand_num = d.demand_num)
left join loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id)
where p.tenant_code=bs.tenant_code and
 ah.holder_num=1 and
w.account_id = b.account_id and w.tenant_code = b.tenant_code and w.account_id = p.account_id
and w.tenant_code = b.tenant_code and w.account_id = p.account_id and
w.tenant_code = p.tenant_code and lp.tenant_code=p.tenant_code and lp.account_id=p.account_id
and ah.tenant_code=p.tenant_code and ah.account_id=p.account_id
and p.branch_code=bs.branch_code and bs.branchset_code ='EDELWEISS' and bk.tenant_code = b.tenant_code
and (p.operational_status=0 or p.closed_on_transaction_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) or p.operational_status=3) and w.tenant_code = $P{tenant_code} group by p.product_code)
union all
(select bk.current_working_date,Sum(w.booked_normal_interest_magnitude),gl_subhead, account_name,p.product_code,'Int_Inc_end' as type from branchset_branches bs,banks bk,account_balances b,loan_od_profiles lp,account_holders ah,account_profiles p,loan_od_working_registers w
left join loan_od_demands d on ( w.tenant_code = d.tenant_code and w.account_id = d.account_id
and w.oldest_due_demand_num = d.demand_num)
left join loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id) where p.tenant_code=bs.tenant_code and w.account_id = b.account_id and w.tenant_code = b.tenant_code and w.account_id = p.account_id
and w.tenant_code = b.tenant_code and w.account_id = p.account_id and
 ah.holder_num=1 and
w.tenant_code = p.tenant_code and lp.tenant_code=p.tenant_code and lp.account_id=p.account_id
and ah.tenant_code=p.tenant_code and ah.account_id=p.account_id
and p.branch_code=bs.branch_code and bs.branchset_code ='EDELWEISS' and bk.tenant_code = b.tenant_code
and (p.operational_status=0 or p.closed_on_transaction_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) or p.operational_status=3) and w.tenant_code = $P{tenant_code} group by p.product_code)
union all
(select bk.current_working_date,sum(w.total_principal_repaid_magnitude+w.total_normal_interest_repaid_magnitude) as cash
 ,gl_subhead, account_name,p.product_code,'Cash_repay_end' as type from branchset_branches bs,banks bk,account_balances b,loan_od_profiles lp,account_holders ah,account_profiles p,
loan_od_working_registers w
left join loan_od_demands d on ( w.tenant_code = d.tenant_code and w.account_id = d.account_id
and w.oldest_due_demand_num = d.demand_num)
left join loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id) where p.tenant_code=bs.tenant_code and w.account_id = b.account_id and w.tenant_code = b.tenant_code and w.account_id = p.account_id
and w.tenant_code = b.tenant_code and w.account_id = p.account_id and
 ah.holder_num=1 and
w.tenant_code = p.tenant_code and lp.tenant_code=p.tenant_code and lp.account_id=p.account_id
and ah.tenant_code=p.tenant_code and ah.account_id=p.account_id
and p.branch_code=bs.branch_code and bs.branchset_code ='EDELWEISS' and bk.tenant_code = b.tenant_code
and (p.operational_status=0 or p.closed_on_transaction_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) or p.operational_status=3) and w.tenant_code = $P{tenant_code} group by p.product_code)
union all
(select bk.current_working_date,sum(w.total_penal_interest_repaid_magnitude) as penal
 ,gl_subhead, account_name,p.product_code,'Penal_repay_end' as type from branchset_branches bs,banks bk,account_balances b,loan_od_profiles lp,account_holders ah,account_profiles p,loan_od_working_registers w
left join loan_od_demands d on ( w.tenant_code = d.tenant_code and w.account_id = d.account_id
and w.oldest_due_demand_num = d.demand_num)
left join loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id) where p.tenant_code=bs.tenant_code and w.account_id = b.account_id and w.tenant_code = b.tenant_code and w.account_id = p.account_id
and w.tenant_code = b.tenant_code and w.account_id = p.account_id and
 ah.holder_num=1 and
w.tenant_code = p.tenant_code and lp.tenant_code=p.tenant_code and lp.account_id=p.account_id
and ah.tenant_code=p.tenant_code and ah.account_id=p.account_id
and p.branch_code=bs.branch_code and bs.branchset_code ='EDELWEISS' and bk.tenant_code = b.tenant_code
and (p.operational_status=0 or p.closed_on_transaction_date<=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) or p.operational_status=3) and w.tenant_code = $P{tenant_code} group by p.product_code)
 order by product_code;]]>
	</queryString>
	<field name="current_working_date" class="java.sql.Date"/>
	<field name="NormalInterest" class="java.math.BigDecimal"/>
	<field name="gl_subhead" class="java.lang.String"/>
	<field name="account_name" class="java.lang.String"/>
	<field name="product_code" class="java.lang.String"/>
	<field name="type" class="java.lang.String"/>
	<variable name="Int Rcv CR" class="java.math.BigDecimal" resetType="Group" resetGroup="ProductCodeGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "RCV_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
		<initialValueExpression><![CDATA[$F{type}.equals( "RCV_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></initialValueExpression>
	</variable>
	<variable name="Prin Rcv CR" class="java.math.BigDecimal" resetType="Group" resetGroup="ProductCodeGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "prin_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
		<initialValueExpression><![CDATA[$F{type}.equals( "prin_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></initialValueExpression>
	</variable>
	<variable name="Cash CR" class="java.math.BigDecimal" resetType="Group" resetGroup="ProductCodeGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "end_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
	</variable>
	<variable name="Cash End" class="java.math.BigDecimal" resetType="Group" resetGroup="ProductCodeGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "cash_end" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
	</variable>
	<variable name="Int Inc CR" class="java.math.BigDecimal" resetType="Group" resetGroup="ProductCodeGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "Inc_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
	</variable>
	<variable name="Int Accr End" class="java.math.BigDecimal" resetType="Group" resetGroup="ProductCodeGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "Int_Accr_end" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
	</variable>
	<variable name="Prin End" class="java.math.BigDecimal" resetType="Group" resetGroup="ProductCodeGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "Prin_end" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
	</variable>
	<variable name="Int Inc End" class="java.math.BigDecimal" resetType="Group" resetGroup="ProductCodeGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "Int_Inc_end" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
		<initialValueExpression><![CDATA[$F{type}.equals( "Int_Inc_end" )?$F{NormalInterest}:(new BigDecimal("0"))]]></initialValueExpression>
	</variable>
	<variable name="Cash Repay End" class="java.math.BigDecimal" resetType="Group" resetGroup="ProductCodeGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "Cash_repay_end" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
	</variable>
	<variable name="Sum Int Rcv CR" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "RCV_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
		<initialValueExpression><![CDATA[$F{type}.equals( "RCV_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></initialValueExpression>
	</variable>
	<variable name="Sum Prin Rcv CR" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "prin_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
		<initialValueExpression><![CDATA[$F{type}.equals( "prin_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></initialValueExpression>
	</variable>
	<variable name="Sum Cash CR" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "end_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
		<initialValueExpression><![CDATA[$F{type}.equals( "end_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></initialValueExpression>
	</variable>
	<variable name="Sum Int Inc CR" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "Inc_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
		<initialValueExpression><![CDATA[$F{type}.equals( "Inc_CR" )?$F{NormalInterest}:(new BigDecimal("0"))]]></initialValueExpression>
	</variable>
	<variable name="Sum Cash End" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "cash_end" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
		<initialValueExpression><![CDATA[$F{type}.equals( "cash_end" )?$F{NormalInterest}:(new BigDecimal("0"))]]></initialValueExpression>
	</variable>
	<variable name="Sum Int Accr End" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{type}.equals( "Int_Accr_end" )?$F{NormalInterest}:(new BigDecimal("0"))]]></variableExpression>
		<initialValueExpression><![CDATA[$F{type}.equals( "Int_Accr_end" )?$F{NormalInterest}:(new BigDecimal("0"))]]></initialValueExpression>
