<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="trialBalanceReport" language="groovy" pageWidth="640" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="620" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" isFloatColumnFooter="true" uuid="63cc24f1-c213-4e45-b28c-2bfa13c04b58">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="imagePath" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select current_working_date,branchset_code,gl_code, gl_subhead, SUM(totalCredit),sum(totalDebit)
from (
select b.branchset_code as branchset_code,bk.current_working_date as current_working_date,
b.branch_code as branch_code, gl.code as gl_code,
case when ap.gl_subhead = 'Cash' then 'Contra'
when ap.gl_subhead = 'Parking' then 'Contra' else ap.gl_subhead end as gl_subhead,
(case when SUM(ab.balance_magnitude)> 0 then SUM(ab.balance_magnitude) else 0 end ) as totalCredit,
(case when SUM(ab.balance_magnitude)< 0 then -1*SUM(ab.balance_magnitude) else 0 end ) as totalDebit
from account_balances ab join account_profiles ap join banks bk join branchset_branches b join gl_subheads gl
where ab.account_id = ap.account_id and ap.gl_subhead = gl.gl_subhead and ab.balance_magnitude <> 0 and ab.tenant_code = ap.tenant_code and ab.tenant_code = b.tenant_code and b.branch_code=ap.branch_code and ( b.branchset_code like 'Pudhu%' or b.branchset_code like 'Dha%'
or b.branchset_code like 'Saha%' or  b.branchset_code like 'Then%' or b.branchset_code like 'Vell%')
and ap.tenant_code = 'KGFS' and ap.tenant_code=bk.tenant_code and bk.tenant_code=b.tenant_code
group by ap.gl_subhead, b.branch_code order by gl.code, b.branch_code,gl.gl_subhead) x
group by gl_subhead,branchset_code order by branchset_code,gl_code,
case when gl_subhead like '%-IntAccr%' then 0 when gl_subhead like '%-IntInc%' then 1
when gl_subhead like '%-IntRcv%' then 2 when gl_subhead like '%-IntSus%' then 3
when gl_subhead like '%-PnlIntAccr%' then 4 when gl_subhead like '%-PnlIntInc%' then 5
when gl_subhead like '%-PnlIntRcv%' then 6 when gl_subhead like '%Principal%' then 7 end]]>
	</queryString>
