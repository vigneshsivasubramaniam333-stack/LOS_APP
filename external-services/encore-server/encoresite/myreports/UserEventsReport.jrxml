	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select user_id,event_type,event_time,remarks,
created_at,created_by
from user_events
where user_events.tenant_code=$P{tenant_code} and
created_at>=$P{from_date} and
 created_at<=$P{to_date} and 
 event_type = $P{event_type_select} or 
 $P{event_type_select} is null or 
 $P{event_type_select}='']]>
	</queryString>
