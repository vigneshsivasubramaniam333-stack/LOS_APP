	</variable>
	<variable name="sumDebitCode" class="java.math.BigDecimal" resetType="Group" resetGroup="code" calculation="Sum">
		<variableExpression><![CDATA[$F{sum(totalDebit)}]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="sumCreditBranchset" class="java.math.BigDecimal" resetType="Group" resetGroup="branchset_code" calculation="Sum">
