		<queryString language="SQL">
			<![CDATA[select p.gl_subhead , p.product_code,p.category,sum(ab.balance_magnitude) as balance
from account_balances ab, account_profiles ap , products p, branchset_branches bsb
where ab.account_id = ap.account_id and ab.tenant_code = ap.tenant_code and ab.tenant_code = $P{tenant_code}
and p.product_code=ap.product_code and p.tenant_code=ap.tenant_code and p.category='Income' 
and ap.tenant_code = bsb.tenant_code and ap.branch_code = bsb.branch_code and bsb.branchset_code=$P{branchset_code_select}
group by p.gl_subhead,p.product_code,p.category having balance<>0]]>
		</queryString>
