	<parameter name="customerId_text" class="java.lang.String">
		<parameterDescription><![CDATA[CustomerId]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT bk.bank_name,ld.account_id,ah.customer_id,concat(ah.first_name," ",middle_name," ",last_name) as customerName,
b.branch_name,ld.value_date,ld.transaction_date,ld.amount_magnitude,
ld.transaction_id,ld.tenant_code,ld.repayment_num, DATE_SUB(bk.current_working_date,INTERVAL 1 DAY) as currentDate
FROM loan_od_repayments ld ,account_profiles ap ,account_holders ah,
branchset_branches bs,branches b,banks bk where b.tenant_code=bk.tenant_code and b.tenant_code=ap.tenant_code and
ld.tenant_code=ap.tenant_code and ap.tenant_code=ah.tenant_code and b.branch_code=ap.branch_code and
ah.tenant_code=bs.tenant_code and ap.account_id=ah.account_id and ah.holder_num=1 
and (ah.customer_id= $P{customerId_text}  or $P{customerId_text} = ' ' or $P{customerId_text} is null)
and ld.account_id=ap.account_id and ap.branch_code=bs.branch_code and ap.tenant_code=$P{tenant_code} 
and (ld.account_id= $P{accountId_text} or $P{accountId_text}=' ' or $P{accountId_text} is null)
and bs.branchset_code =$P{branchset_code_select} and (ld.transaction_date>=$P{from_date} and ld.transaction_date<=$P{to_date});]]>
	</queryString>
	<field name="bank_name" class="java.lang.String"/>
	<field name="account_id" class="java.lang.String"/>
	<field name="customer_id" class="java.lang.String"/>
	<field name="customerName" class="java.lang.String"/>
