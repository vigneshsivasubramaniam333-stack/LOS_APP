<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BookedInterestReport" language="groovy" pageWidth="1150" pageHeight="842" columnWidth="1130" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" isIgnorePagination="true" uuid="4a0ad14c-729f-4a0f-8595-07a98353ff2c">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="109"/>
	<property name="ireport.y" value="0"/>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[BranchSet Code]]></parameterDescription>
	</parameter>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ic.account_id,t.tag, ap.branch_code,ap.product_code,ic.start_date as from_date,
ic.computation_date as to_date,
ic.interest_magnitude, ic.amount_magnitude as balance, ic.tenure_days as tenure_days, case when ic.interest_type=0 then 'Normal Interest' else 'Penal Interest' end as interest_type,(ic.tenure_days - (greatest(DATEDIFF($P{from_date}, ic.start_date),0) + greatest(DATEDIFF(ic.computation_date,$P{to_date}),0))) as applicable_days
FROM interest_computations ic ,account_profiles ap left join loan_od_tags t on ( ap.tenant_code = t.tenant_code and ap.account_id = t.account_id), branchset_branches bs
where ic.tenant_code=ap.tenant_code and ic.tenant_code=bs.tenant_code and ic.account_id=ap.account_id and ap.branch_code=bs.branch_code and bs.branchset_code =$P{branchset_code_select}
and ic.tenant_code=$P{tenant_code}
and (ic.computation_date>=$P{from_date} and ic.start_date<=$P{to_date}) order by ic.interest_type,ic.account_id, ic.start_date]]>
	</queryString>
	<field name="account_id" class="java.lang.String"/>
	<field name="tag" class="java.lang.String"/>
	<field name="branch_code" class="java.lang.String"/>
	<field name="product_code" class="java.lang.String"/>
	<field name="from_date" class="java.sql.Date"/>
	<field name="to_date" class="java.sql.Date"/>
	<field name="interest_magnitude" class="java.math.BigDecimal"/>
	<field name="balance" class="java.math.BigDecimal"/>
	<field name="tenure_days" class="java.lang.Integer"/>
	<field name="interest_type" class="java.lang.String"/>
	<field name="applicable_days" class="java.lang.Long"/>
	<variable name="variable1" class="java.lang.String"/>
