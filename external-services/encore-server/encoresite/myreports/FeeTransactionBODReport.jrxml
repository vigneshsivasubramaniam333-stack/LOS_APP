	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="979"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="encoredb"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date Preceding]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To  Date Preceding]]></parameterDescription>
	</parameter>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[Branchset Code]]></parameterDescription>
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<parameter name="instrument_select" class="java.lang.String">
		<parameterDescription><![CDATA[InstrumentSelect]]></parameterDescription>
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select f.account_id,ah.customer_id,ap.branch_code,ap.product_code,f.charged_value_date,f.charged_transaction_date, 
fp.payment_value_date, fp.payment_transaction_date, fp.payment_transaction_id, f.gross_amount_magnitude,
f.fee_category,f.fee_description,case when f.payment_status =0 then 'Not Paid' when f.payment_status=1 
then "Paid"  end as PaymentStatus from fees f left join fee_payments fp on (f.tenant_code=fp.tenant_code and 
 f.account_id=fp.account_id and f.fee_num=fp.fee_num and fp.instrument=$P{instrument_select} ) ,account_profiles ap ,account_holders ah, branchset_branches bs
where f.tenant_code=ap.tenant_code and f.tenant_code=bs.tenant_code and f.account_id=ap.account_id and 
ap.tenant_code=ah.tenant_code and ah.holder_num=1 and ap.account_id=ah.account_id and ap.branch_code=bs.branch_code
 and f.gross_amount_magnitude <> 0 and bs.branchset_code =$P{branchset_code_select} and 
 ap.tenant_code=$P{tenant_code} and 
 ((f.charged_transaction_date>=DATE_SUB($P{from_date},INTERVAL 1 DAY) and 
 f.charged_transaction_date<=DATE_SUB($P{to_date},INTERVAL 1 DAY)) or 
 (fp.payment_transaction_date>=DATE_SUB($P{from_date},INTERVAL 1 DAY) and 
 fp.payment_transaction_date<=DATE_SUB($P{to_date},INTERVAL 1 DAY)))]]>
	</queryString>
