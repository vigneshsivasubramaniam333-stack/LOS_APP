<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LoanDetails" language="groovy" pageWidth="1000" pageHeight="842" columnWidth="1000" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="6ac92c9f-f72e-422f-a798-95b411fc2f2f">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.account_id,w.total_disbursed_magnitude,w.total_demand_due_magnitude,
w.total_repaid_magnitude,(w.total_demand_due_magnitude-ld.amount_magnitude) as overDue,
ab.balance_magnitude, a.first_name, a.middle_name, a.last_name,
a.customer_id, p.currency_code, w.total_fee_due_magnitude
from account_holders a, account_balances ab, loan_od_working_registers w,
account_profiles p,loan_od_demands ld,banks b where w.tenant_code = a.tenant_code and
p.tenant_code = ab.tenant_code and p.tenant_code = a.tenant_code and
w.tenant_code = a.tenant_code and a.tenant_code = $P{tenant_code} and
a.account_id = w.account_id and ab.account_id = p.account_id and
a.account_id = ld.account_id and a.account_id = p.account_id and
ld.demand_date=b.current_working_date and w.total_demand_due_magnitude > 0 and p.operational_status=0
and a.holder_num = 1 order by a.account_id]]>
	</queryString>
	<field name="account_id" class="java.lang.String"/>
	<field name="total_disbursed_magnitude" class="java.math.BigDecimal"/>
	<field name="total_demand_due_magnitude" class="java.math.BigDecimal"/>
