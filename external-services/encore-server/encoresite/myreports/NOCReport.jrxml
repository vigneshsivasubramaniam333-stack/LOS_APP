	<parameter name="imagePath" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ap.branch_code, br.branch_name, ap.account_id, date_format(b.current_working_date, "%d/%m/%Y") as current_working_date, ifnull(c.phone1,'N/A') as phone1, 
concat(COALESCE(ah.first_name,''),' ',COALESCE(ah.middle_name,''),' ',COALESCE(ah.last_name,'')) as customer_name,
concat(COALESCE(ah.address1,''),' ',COALESCE(ah.address2,''),' ',COALESCE(ah.address3,'')) as address
from banks b, account_profiles ap, customers c, account_holders ah, branches br
where b.tenant_code=ap.tenant_code and ap.tenant_code=c.tenant_code and c.tenant_code=ah.tenant_code and ah.tenant_code=br.tenant_code and 
c.branch_code=ap.branch_code and ap.branch_code=br.branch_code and
ah.customer_id=c.customer_id and 
ap.account_id=ah.account_id and ah.holder_num=1 and ap.operational_status=2
and ap.account_id= $P{accountId_text} and b.tenant_code= $P{tenant_code}]]>
	</queryString>
