	<parameter name="tenant_code" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[Select p.product_code,p.branch_code,sum(b.balance_magnitude) as balance
from account_profiles p,account_balances b, products ps where
p.account_id = b.account_id and p.tenant_code = b.tenant_code and p.tenant_code = ps.tenant_code and
p.tenant_code =$P{tenant_code} and ps.gl_subhead = p.gl_subhead and p.currency_code=ps.currency_code and b.balance_magnitude != 0
and p.product_type = 'Internal' and ps.gl_subhead in ('Forfeiture', 'Waiver') group by p.branch_code, ps.gl_subhead]]>
	</queryString>
	<field name="product_code" class="java.lang.String"/>
	<field name="branch_code" class="java.lang.String"/>
	<field name="balance" class="java.math.BigDecimal"/>
