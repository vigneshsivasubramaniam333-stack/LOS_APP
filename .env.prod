# Copy this file to .env.prod and change passwords/secrets before deployment.
POSTGRES_DB=losdb
POSTGRES_USER=losuser
POSTGRES_PASSWORD=Bltest@123

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8083
DOCUMENT_STORAGE_PATH=/data/documents

# Optional app secrets if your backend uses JWT/security configs.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Frontend production uses Nginx reverse proxy. Keep as /api.
VITE_API_BASE_URL=/api/v1

# Host port for los_ui (8080 — host nginx keeps port 80)
LOS_UI_HOST_PORT=8080

# Credinnov sandbox Encore API — Tomcat context is /credinnov-encore-server/ (see host nginx proxy_pass).
# UI: http://credinnov-sandbox.senseitech.com/encore-client/
ENCORE_BASE_URL=http://host.docker.internal:8091/credinnov-encore-server/encore/
ENCORE_API_USERNAME=vuser
ENCORE_API_PASSWORD=vuser

LOS_DOCUMENT_STORAGE=local
LOS_FILE_STORAGE_ROOT=/data/documents

# LOS → PLP integration (same EC2: gateway on host port 8180)
PLP_BASE_URL=http://host.docker.internal:8180
PLP_INTEGRATION_EMAIL=admin@credinnov.com
PLP_INTEGRATION_PASSWORD=Bltest@123
PLP_LOS_INTEGRATION_API_KEY=plp-los-integration-dev-key