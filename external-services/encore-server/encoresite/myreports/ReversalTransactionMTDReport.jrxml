	<queryString>
		<![CDATA[select ld.account_id,ld.transaction_description,ld.value_date,ld.transaction_date,ld.principal_magnitude,ld.normal_interest_magnitude,ld.penal_interest_magnitude, ld.amount_magnitude,ld.balance_magnitude,ld.transaction_id,ld.reversal_transaction_id,ld.reversal_user_id,reversal_transaction_date,ah.customer_id,ap.branch_code,ap.product_code from loan_od_history_transactions ld ,account_profiles ap ,account_holders ah where ld.tenant_code=ap.tenant_code and ap.tenant_code=ah.tenant_code and ap.account_id=ah.account_id and ah.holder_num=1 and ld.account_id=ap.account_id and ld.transaction_description in ('Disbursement', 'Prepayment', 'ScheduledRepayment', 'Pre-closure', 'AdvanceRepayment', 'WriteOff', 'Settlement', 'Full Settlement', 'Recovery', 'Final Recovery', 'Fee Charge', 'Fee Payment','Internal Preclosure','Restructuring') and ap.tenant_code=$P{tenant_code} and ld.reversal_transaction_date > DATE_SUB($P{to_date},interval day($P{to_date}) day) and ld.reversal_transaction_date < $P{to_date}]]>
	</queryString>
