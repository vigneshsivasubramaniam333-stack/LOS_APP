<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DisbursementMTD" pageWidth="2700" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="2700" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="6462b675-f0d8-453d-ae99-24f379350ece">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="TestzEncore"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[BranchSet Code]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT ah.customer_id,ld.account_id,ap.product_code,ap.branch_code,b.branch_name,
ld.amount_magnitude,ld.value_date,ld.transaction_date, ld.transaction_id,ld.user_id,ld.net_disbursement_magnitude,
concat(COALESCE(ah.first_name,''),' ',COALESCE(ah.middle_name,''),' ',COALESCE(ah.last_name)) as customerName,c.sector,
ap.account_name, f1.amount_magnitude as Fee1Amount,f1.gross_amount_magnitude as Fee1GrossAmount, f2.gross_amount_magnitude as fee2_amount, f3.gross_amount_magnitude as fee3_amount , 
concat(COALESCE(la.first_name,''),' ',COALESCE(la.middle_name,''),' ',COALESCE(la.last_name)) as guarantorName 
FROM
loan_od_profiles lp left join loan_od_associates la on (lp.tenant_code=la.tenant_code and lp.account_id=la.account_id and la.associate_type=1 and la.sequence_num=1)
left join customers cs on (la.tenant_code=cs.tenant_code and la.associate_id=cs.customer_id),
account_profiles ap
left join loan_od_products pd on (ap.tenant_code=pd.tenant_code and ap.product_code=pd.product_code and ap.currency_code=pd.currency_code)
left join loan_od_disbursements ld on (ld.tenant_code=ap.tenant_code  and ld.account_id=ap.account_id )
left join fees f1 on (f1.tenant_code=ap.tenant_code and f1.account_id=ap.account_id and f1.fee_category=(Select en.name from enumerations en where en.tenant_code=f1.tenant_code and en.reference=1 and en.classifier='FeeName'))
left join fees f2 on (f2.tenant_code=ap.tenant_code and f2.account_id=ap.account_id and f2.fee_category=(Select en.name from enumerations en where en.tenant_code=f2.tenant_code and en.reference=2 and en.classifier='FeeName')  )
left join fees f3 on (f3.tenant_code=ap.tenant_code and f3.account_id=ap.account_id and f3.fee_category=(Select en.name from enumerations en where en.tenant_code=f3.tenant_code and en.reference=3 and en.classifier='FeeName')  )
left join fees f4 on (f4.tenant_code=ap.tenant_code and f4.account_id=ap.account_id and f4.fee_category=(Select en.name from enumerations en where en.tenant_code=f4.tenant_code and en.reference=4 and en.classifier='FeeName')  )
left join fees f5 on (f5.tenant_code=ap.tenant_code and f5.account_id=ap.account_id and f5.fee_category=(Select en.name from enumerations en where en.tenant_code=f5.tenant_code and en.reference=5 and en.classifier='FeeName')  )
left join fees f6 on (f6.tenant_code=ap.tenant_code and f6.account_id=ap.account_id and f6.fee_category=(Select en.name from enumerations en where en.tenant_code=f6.tenant_code and en.reference=6 and en.classifier='FeeName') )
left join fees f7 on (f7.tenant_code=ap.tenant_code and f7.account_id=ap.account_id and f7.fee_category=(Select en.name from enumerations en where en.tenant_code=f7.tenant_code and en.reference=7 and en.classifier='FeeName')  )
left join fees f8 on (f8.tenant_code=ap.tenant_code and f8.account_id=ap.account_id and f8.fee_category=(Select en.name from enumerations en where en.tenant_code=f8.tenant_code and en.reference=8 and en.classifier='FeeName')  ),
account_holders ah,branches b,branchset_branches bs, customers c
where ld.tenant_code=lp.tenant_code and ah.tenant_code=c.tenant_code and ah.tenant_code=c.tenant_code and ld.tenant_code=ap.tenant_code 
and ld.tenant_code=bs.tenant_code and ah.holder_num=1 and ld.account_id=ap.account_id and ap.tenant_code=ah.tenant_code and 
ap.account_id=ah.account_id and ah.tenant_code=b.tenant_code and ap.branch_code=b.branch_code and ap.branch_code=bs.branch_code and 
ah.customer_id=c.customer_id and ld.account_id=lp.account_id and bs.branchset_code ='All' and ap.tenant_code=$P{tenant_code} and 
(ld.transaction_date>=DATE_ADD(DATE_SUB(DATE_SUB($P{to_date},INTERVAL 1 DAY),interval day(DATE_SUB($P{to_date},INTERVAL 1 DAY)) day), interval 1 day) and ld.transaction_date<=DATE_SUB($P{to_date},INTERVAL 1 DAY));]]>
	</queryString>
