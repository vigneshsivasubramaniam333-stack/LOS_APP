	<queryString>
		<![CDATA[select pa.account_id,pa.subject,pa.customer_id,pa.email_id,
pa.phone,pa.response as Respone,pa.text_message as Message,
pa.alert_type,pa.transaction_date from processed_alerts pa, account_profiles ap, branchset_branches bs 
where pa.tenant_code=ap.tenant_code and ap.tenant_code=bs.tenant_code and pa.account_id=ap.account_id and ap.branch_code=bs.branch_code and 
(alert_type=$P{alert_type_select} or $P{alert_type_select} is null 
	or $P{alert_type_select} ='' or ($P{alert_type_select}='All' and (alert_type='Sms' or alert_type='Email')))
and (pa.transaction_date >= $P{from_date} and pa.transaction_date <= $P{to_date}) 
and bs.branchset_code =$P{branchset_code_select} and pa.tenant_code=$P{tenant_code}]]>
	</queryString>
