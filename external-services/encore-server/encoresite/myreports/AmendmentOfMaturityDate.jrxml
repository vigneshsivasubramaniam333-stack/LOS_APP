	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="julydb"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ah.account_id, ah.customer_id, concat(COALESCE(ah.first_name,''),' ',COALESCE(ah.middle_name,''),' ',COALESCE(ah.last_name,'')) as customer_name,
l.value_date, l.old_maturity_date, l.new_date, ifnull(l.description,'') as remarks, l.transaction_id, l.created_at, l.user_id
from account_holders ah, loan_od_amendments l
where ah.tenant_code=l.tenant_code
and ah.account_id=l.account_id
and l.amendment_type='6' 
and (l.value_date>=$P{from_date} and l.value_date<=$P{to_date})
and ah.tenant_code= $P{tenant_code}]]>
	</queryString>
	<field name="account_id" class="java.lang.String"/>
	<field name="customer_id" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="value_date" class="java.lang.String"/>
	<field name="old_maturity_date" class="java.lang.String"/>
