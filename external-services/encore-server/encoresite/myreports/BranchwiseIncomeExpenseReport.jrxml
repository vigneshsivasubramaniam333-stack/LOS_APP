	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[Select p.product_code,p.branch_code,sum(b.balance_magnitude) as balance,p.currency_code 
from account_profiles p,account_balances b, products ps where
p.account_id = b.account_id and p.tenant_code = b.tenant_code and ps.tenant_code=p.tenant_code and 
p.tenant_code =$P{tenant_code}  and b.balance_magnitude != 0 and ps.product_code=p.product_code and 
p.currency_code = ps.currency_code and p.product_type = 'Internal' and ( ps.category in ('Income', 'Expense') 
and ps.gl_subhead != 'Profit And Loss' ) group by p.branch_code ]]>
	</queryString>
	<field name="product_code" class="java.lang.String"/>
	<field name="branch_code" class="java.lang.String"/>
	<field name="balance" class="java.math.BigDecimal"/>
	<field name="currency_code" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
