<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DemandOverdueReport" language="groovy" pageWidth="1600" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="1580" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" isIgnorePagination="true" uuid="62ea1fd8-53e1-407a-8782-c7cff7934a97">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="encoredb"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[BranchSet Code]]></parameterDescription>
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select w.account_id,lp.amount_magnitude,ah.customer_id,p.branch_code,case when
w.oldest_due_demand_num = 0 then 0 else datediff(bk.current_working_date, d.demand_date)
end as dpd,bc.branch_name,
w.total_demand_due_magnitude,lp.guarantor_customer_id1,concat(ah.first_name,' ',ah.middle_name,' ',ah.last_name) as customerName,concat(c.first_name,' ',c.middle_name,' ',c.last_name) as guarantorName, ah.phone1 as customerPhone1,c.phone1 as guarantorPhone1,
(w.total_fee_due_magnitude+w.total_normal_interest_due_magnitude+w.total_penal_interest_due_magnitude+w.booked_not_due_normal_interest_magnitude+w.booked_not_due_penal_interest_magnitude+(-b.balance_magnitude)) as payOffAmount 
from banks bk,account_balances b,branches bc,
account_holders ah,account_profiles p ,branchset_branches bs, loan_od_working_registers w left join loan_od_demands d on ( w.tenant_code = d.tenant_code
and w.account_id = d.account_id and w.oldest_due_demand_num = d.demand_num) left join
loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id) left join fees f on (w.tenant_code = f.tenant_code and w.account_id = f.account_id and f.fee_category='Processing Fee' ),loan_od_profiles lp left join customers c on (lp.tenant_code = c.tenant_code and lp.guarantor_customer_id1=c.customer_id)
where ah.holder_num=1 and w.account_id = b.account_id and w.tenant_code = b.tenant_code and w.tenant_code = bs.tenant_code
and w.account_id = p.account_id and w.tenant_code = b.tenant_code and w.tenant_code = bc.tenant_code and w.account_id = p.account_id and p.branch_code=bc.branch_code and p.branch_code=bs.branch_code
and w.tenant_code = p.tenant_code and lp.tenant_code=p.tenant_code and lp.account_id=p.account_id
and ah.tenant_code=p.tenant_code and ah.account_id=p.account_id and bk.tenant_code = b.tenant_code and w.first_disbursement_date is not null and w.oldest_due_demand_num > 0 and w.tenant_code = $P{tenant_code} and  bs.branchset_code = $P{branchset_code_select} group  by p.account_id;]]>
	</queryString>
