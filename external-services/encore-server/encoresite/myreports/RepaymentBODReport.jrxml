	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date Preceding]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date Preceding]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[Branchset Code]]></parameterDescription>
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<parameter name="instrument_select" class="java.lang.String">
		<parameterDescription><![CDATA[InstrumentSelect]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT ld.account_id,ah.customer_id,concat(ah.first_name," ",ah.middle_name," ",ah.last_name) as customerName,ap.branch_code,ap.product_code,ld.value_date,ld.transaction_date,ld.amount_magnitude,
(principal_magnitude+principal_adjustment_magnitude) as Principal,
(normal_interest_magnitude+normal_interest_adjustment_magnitude) as NormalInterest,
(penal_interest_magnitude+penal_interest_adjustment_magnitude) as PenalInterest,
(ld.amount_magnitude-(principal_magnitude+principal_adjustment_magnitude+
normal_interest_magnitude+normal_interest_adjustment_magnitude+
penal_interest_magnitude+penal_interest_adjustment_magnitude)) as Forfeiture, ld.transaction_id,
ld.user_id,ld.instrument,SUBSTRING_INDEX(SUBSTRING_INDEX(ld.reference, 'accountCode', -1), '|', 1) as reference,ld.created_at,ld.repayment_type,lt.tag,(lp.normal_interest_rate*100), 
b.branch_name, ld.old_dpd, ld.dpd,c.sector, ld.interest_tds_magnitude, 
concat(COALESCE(cs.first_name,''),' ',COALESCE(cs.middle_name,''),' ',COALESCE(cs.last_name)) as guarantorName
FROM loan_od_repayments ld ,account_profiles ap, loan_od_profiles lp left join customers cs on (lp.tenant_code=cs.tenant_code and lp.guarantor_customer_id1=cs.customer_id),
 account_holders ah left join
loan_od_tags lt on (ah.tenant_code = lt.tenant_code and ah.account_id = lt.account_id),
branchset_branches bs, branches b, customers c where c.tenant_code=ah.tenant_code and 
c.customer_id=ah.customer_id and bs.tenant_code=b.tenant_code and ld.tenant_code=ap.tenant_code and ap.tenant_code=ah.tenant_code and ap.tenant_code=lp.tenant_code and ap.account_id=lp.account_id and
ah.tenant_code=bs.tenant_code and ap.account_id=ah.account_id and ah.holder_num=1 and
ld.account_id=ap.account_id and b.branch_code=bs.branch_code and ap.branch_code=bs.branch_code and ap.tenant_code=$P{tenant_code}
and   bs.branchset_code =$P{branchset_code_select} and (ld.instrument=$P{instrument_select} or $P{instrument_select}='' or $P{instrument_select} is null)
and (ld.transaction_date>=DATE_SUB($P{from_date},INTERVAL 1 DAY) and ld.transaction_date<=DATE_SUB($P{to_date},INTERVAL 1 DAY));]]>
	</queryString>
