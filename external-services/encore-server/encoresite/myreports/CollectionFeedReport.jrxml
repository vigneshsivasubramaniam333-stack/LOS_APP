<!-- Created with Jaspersoft Studio version 6.6.0.final using JasperReports Library version 6.6.0  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CollectionFeedReport" pageWidth="6400" pageHeight="842" columnWidth="6380" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" isIgnorePagination="true" uuid="74545910-6fb1-489a-95f7-6f952f2d48ed">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="encore3944"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select b.bank_name,lp.account_id,ah.customer_id, REPLACE(REPLACE(REPLACE(ap.product_code, "-", ""),"(",""),")","") as product_code, ap.account_name,ap.operational_status,la.associate_id,
'' as relationship_manager,w.last_repayment_date,lp.udf_text8,cs.sector,ci.city_name,si.state_name,
concat(COALESCE(cs.address1,''),COALESCE(cs.address2,''),COALESCE(cs.address3,'')) as GuarantorAddress,
concat(COALESCE(la.first_name,''),(case when COALESCE(la.middle_name,'')='' then '' else (concat(' ',COALESCE(la.middle_name,''))) end),' ',COALESCE(la.last_name,'')) as guarantorName,cs.phone1,
concat(COALESCE(ah.address1,''),COALESCE(ah.address2,''),COALESCE(ah.address3,'')) as Address, 
ah.country_code,ah.pin_code,ah.phone1,ah.phone2,ah.email, br.branch_name,
concat(COALESCE(ah.first_name,''),(case when COALESCE(ah.middle_name,'')='' then '' else (concat(' ',COALESCE(ah.middle_name,''))) end),' ',COALESCE(ah.last_name,'')) as customerName,
w.first_disbursement_date, LEFT(b.bank_name , 1) as ledger, lp.amount_magnitude, ap.opened_on_value_date, lp.tenure_days, 
w.installment_amount_magnitude, w.total_principal_due_magnitude, w.total_normal_interest_due_magnitude,w.total_penal_interest_due_magnitude,'' as OtherChargesOverdue,
w.booked_not_due_normal_interest_magnitude,w.booked_not_due_penal_interest_magnitude, 
(-ab.balance_magnitude+w.total_normal_interest_due_magnitude+w.total_penal_interest_due_magnitude+w.booked_not_due_normal_interest_magnitude+w.booked_not_due_penal_interest_magnitude) as payOffAmountWithDue, 
w.total_demand_due_magnitude,case when w.oldest_due_demand_num = 0 then 0 else datediff(b.current_working_date, d.demand_date) end as dpd,-ab.balance_magnitude,
case when c.customer_type=0 then 'Individual' when c.customer_type=1 then 'Organisation' when c.customer_type=2 then 'Public Limited' 
when c.customer_type=3 then 'Private Limited' when c.customer_type=4 then 'Partnership' when c.customer_type=5 then 'Society' 
when c.customer_type=6 then 'Trust' when c.customer_type=7 then 'Government' when c.customer_type=8 then 'HUF' when c.customer_type=9 then 'FII' 
when c.customer_type=10 then 'AOPBOI' when c.customer_type=11 then 'NRI'  when c.customer_type=12 then 'SHG or JLG' else 'Others' end as CustomerType, w.next_demand_run_date,
case when w.oldest_due_demand_num = 0 then 0 else case when ht.effective_date is null then datediff(b.current_working_date, d.demand_date) 
when  datediff(d.demand_date, ht.effective_date) > 0 then datediff(b.current_working_date, d.demand_date) 
else datediff(b.current_working_date, d.demand_date) - least(datediff(b.current_working_date, ht.effective_date), (datediff( ht.expiry_date, ht.effective_date)+1)) end end as effective_dpd 
from loan_od_products p, account_profiles ap,account_balances ab, cities ci,states si,
loan_od_profiles lp left join loan_od_associates la on (la.tenant_code=lp.tenant_code and la.account_id=lp.account_id and la.associate_type=1 and la.sequence_num=1) 
left join customers cs on (la.tenant_code=cs.tenant_code and la.associate_id=cs.customer_id), 
loan_od_working_registers w left join loan_od_demands d on ( w.tenant_code = d.tenant_code
and w.account_id = d.account_id and w.oldest_due_demand_num = d.demand_num) left join loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id) 
left join loan_od_history_tags ht on (w.tenant_code=ht.tenant_code and w.account_id=ht.account_id and ht.classifier='Moratorium'), account_holders ah, customers c, branches br, banks b
where b.tenant_code=br.tenant_code and ap.tenant_code=br.tenant_code and p.tenant_code=ap.tenant_code and ap.tenant_code=ab.tenant_code and ap.tenant_code=lp.tenant_code and 
lp.tenant_code=w.tenant_code and lp.tenant_code=ah.tenant_code and ah.tenant_code=c.tenant_code and
 p.product_code=ap.product_code and ap.account_id=lp.account_id and ap.account_id=ab.account_id and ap.operational_status=0 and lp.account_id=ah.account_id and ap.branch_code=br.branch_code 
 and lp.account_id=w.account_id and ah.customer_id=c.customer_id and ah.state_code=si.state_code and ah.city_code=ci.city_code and ah.holder_num=1 and lp.tenant_code=$P{tenant_code}]]>
	</queryString>
