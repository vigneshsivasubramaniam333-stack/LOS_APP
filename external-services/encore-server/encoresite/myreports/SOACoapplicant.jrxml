	<parameter name="accountId_text" class="java.lang.String"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select concat(COALESCE(ah1.first_name,' '),' ',COALESCE(ah1.middle_name,' '),' ',COALESCE(ah1.last_name,' ')) as customer_name1,
concat(COALESCE(ah1.address1,''),' ',COALESCE(ah1.address2,''),' ',COALESCE(ah1.address3,''),' ',COALESCE(ah1.city_code,''),' ',
COALESCE(ah1.state_code,''),' ',COALESCE(ah1.district_code,''),' ',COALESCE(ah1.pin_code,'')) as address2,ifnull(ah1.phone1,'N/A') as phone,ifnull(ah1.phone2,'N/A') as phoneah,ifnull(ah1.email,'N/A') as emailah,ah1.holder_num,
lp.account_id from loan_od_profiles lp left join account_holders ah1 on(lp.account_id=ah1.account_id) where ah1.holder_num > 1 and
lp.account_id=$P{accountId_text} and ah1.tenant_code=$P{tenant_code}]]>
	</queryString>
