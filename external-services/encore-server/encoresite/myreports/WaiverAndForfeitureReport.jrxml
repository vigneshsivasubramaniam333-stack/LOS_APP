<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="WaiverAndForfeitureReport" language="groovy" pageWidth="600" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="600" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="183d11cf-9019-447c-83f7-be1738d57a20">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[Branchset Code]]></parameterDescription>
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT ap.account_id,ap.branch_code,ap.product_code,lr.value_date,
(lr.amount_magnitude - (lr.principal_magnitude+lr.normal_interest_magnitude+lr.penal_interest_magnitude+lr.principal_adjustment_magnitude+lr.normal_interest_adjustment_magnitude+lr.penal_interest_adjustment_magnitude)) delta
 FROM loan_od_repayments lr,account_profiles ap, branchset_branches bs
 where ap.tenant_code=lr.tenant_code and ap.tenant_code=bs.tenant_code and ap.account_id=lr.account_id and ap.branch_code=bs.branch_code and ap.tenant_code=$P{tenant_code}
and bs.branchset_code =$P{branchset_code_select} and lr.transaction_date>=$P{from_date} and lr.transaction_date<=$P{to_date}
and (lr.amount_magnitude - (lr.principal_magnitude+lr.normal_interest_magnitude+lr.penal_interest_magnitude+lr.principal_adjustment_magnitude+lr.normal_interest_adjustment_magnitude+lr.penal_interest_adjustment_magnitude)) <> 0
order by lr.value_date, ap.branch_code]]>
	</queryString>
	<field name="account_id" class="java.lang.String"/>
	<field name="branch_code" class="java.lang.String"/>
	<field name="product_code" class="java.lang.String"/>
	<field name="value_date" class="java.sql.Date"/>
	<field name="delta" class="java.math.BigDecimal"/>
