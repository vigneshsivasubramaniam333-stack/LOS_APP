<!-- Created with Jaspersoft Studio version 6.6.0.final using JasperReports Library version 6.6.0  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BackValuedatedTransactionReport" language="groovy" pageWidth="1600" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="1600" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="67a2d3c1-0e40-4605-9ae5-9abcc6d06394">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="TestzEncore"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[(SELECT ld.account_id,ah.customer_id,ap.product_code,ap.branch_code,ld.value_date,
ld.transaction_date,ld.amount_magnitude, case when ld.repayment_type=0
then 'ScheduledRepayment'
when ld.repayment_type=1 then 'AdvanceRepayment'
when ld.repayment_type=2 then 'Prepayment'
when ld.repayment_type=3 then 'Pre-closure'
end as transaction_name,
(principal_magnitude+principal_adjustment_magnitude) as Principal,
(normal_interest_magnitude+normal_interest_adjustment_magnitude) as NormalInterest,
(penal_interest_magnitude+penal_interest_adjustment_magnitude) as PenalInterest,
ld.balance_magnitude, ld.transaction_id, ld.user_id
FROM loan_od_repayments ld ,account_profiles ap ,account_holders ah where
ld.tenant_code=ap.tenant_code and ap.tenant_code=ah.tenant_code and
ap.account_id=ah.account_id and ah.holder_num=1 and
ld.account_id=ap.account_id and
ld.value_date < ld.transaction_date and ap.tenant_code=$P{tenant_code}
and (ld.value_date>=$P{from_date} and ld.value_date<=$P{to_date}))
union all
(SELECT ld.account_id,ah.customer_id,ap.product_code,ap.branch_code,ld.value_date,
ld.transaction_date, ld.amount_magnitude,'Disbursement' as transaction_name,
'0.00' as Principal,
'0.00' as NormalInterest,'0.00' as PenalInterest,ld.balance_magnitude,
 ld.transaction_id, ld.user_id
FROM loan_od_disbursements ld ,account_profiles ap ,account_holders ah where
ld.tenant_code=ap.tenant_code and ap.tenant_code=ah.tenant_code and
ap.account_id=ah.account_id and ah.holder_num=1 and
ld.account_id=ap.account_id and
ld.value_date < ld.transaction_date and ap.tenant_code=$P{tenant_code}
and (ld.value_date>=$P{from_date} and ld.value_date<=$P{to_date}))
union all
(select f.account_id,ah.customer_id,ap.product_code,ap.branch_code,f.charged_value_date,
f.charged_transaction_date,f.gross_amount_magnitude,'Fee Charge' as transaction_name,
'0.00' as Principal,'0.00' as NormalInterest,'0.00' as PenalInterest,'0.00' as balance_magnitude,
f.charged_transaction_id,f.charge_user_id from fees f ,account_profiles ap ,account_holders ah
where f.tenant_code=ap.tenant_code and  f.account_id=ap.account_id and
ap.tenant_code=ah.tenant_code and ah.holder_num=1
and ap.account_id=ah.account_id  and f.gross_amount_magnitude <> 0 and
f.charged_value_date < f.charged_transaction_date
and ap.tenant_code=$P{tenant_code} and f.charged_value_date>=$P{from_date}
and f.charged_value_date<=$P{to_date})
union all
(select f.account_id,ah.customer_id,ap.product_code,ap.branch_code,f.payment_value_date,
f.payment_transaction_date,f.paid_amount_magnitude,'Fee Payment' as transaction_name,
'0.00' as Principal,'0.00' as NormalInterest,'0.00' as PenalInterest,'0.00' as balance_magnitude,
f.payment_transaction_id,f.payment_user_id from fee_payments f ,account_profiles ap ,account_holders ah
where f.tenant_code=ap.tenant_code and  f.account_id=ap.account_id and
ap.tenant_code=ah.tenant_code and ah.holder_num=1
and ap.account_id=ah.account_id  and f.paid_amount_magnitude <> 0 and
f.payment_value_date < f.payment_transaction_date
and ap.tenant_code=$P{tenant_code} and f.payment_value_date>=$P{from_date}
and f.payment_value_date<=$P{to_date})]]>
	</queryString>
	<field name="account_id" class="java.lang.String"/>
