<!-- Created with Jaspersoft Studio version 6.10.0.final using JasperReports Library version 6.10.0-unknown  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AllDataReport.jasper" language="groovy" pageWidth="5800" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="5780" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" isSummaryWithPageHeaderAndFooter="true" isIgnorePagination="true" uuid="ffea01d5-93c9-4fc7-bfb9-0a033be65946">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="7092"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="encoredb"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select w.account_id,w.first_disbursement_date,lp.amount_magnitude,w.maturity_date,
w.total_principal_repaid_magnitude,w.total_normal_interest_repaid_magnitude, case when
w.oldest_due_demand_num = 0 then 0 else datediff(bk.current_working_date, d.demand_date)
end as dpd,'' as rpa,w.total_fee_due_magnitude,w.total_penal_interest_due_magnitude,'' as
lateChargeAsseseedLife,b.balance_magnitude,b.balance_magnitude as bal,
w.total_principal_due_magnitude,w.total_normal_interest_due_magnitude,p.operational_status,
p.closed_on_transaction_date as closed_on_transaction_date, w.last_repayment_date,
w.booked_not_due_normal_interest_magnitude,w.num_demands,w.num_satisfied_demands,lt.tag as
oldAccNo,ah.customer_id,w.first_repayment_date,lp.normal_interest_rate,
w.installment_amount_magnitude as amount_magnitudes,case when
lp.tenure_unit=1 then lp.tenure_days when lp.tenure_unit=2 then ROUND(lp.tenure_days/7) when
lp.tenure_unit=3 then ROUND(lp.tenure_days/14) when lp.tenure_unit=4 then lp.tenure_months
when lp.tenure_unit=5 then ROUND(lp.tenure_months/3) when lp.tenure_unit=6 then ROUND(lp.tenure_months/6)
when lp.tenure_unit=7 then ROUND(lp.tenure_months/12) end as tenure, case when lp.tenure_unit=1
then 'DAY' when lp.tenure_unit=2 then 'WEEK' when lp.tenure_unit=3 then 'FORTNIGHT' when
lp.tenure_unit=4 then 'MONTH' when lp.tenure_unit=5 then 'QUARTER' when lp.tenure_unit=6
then 'HALF_YEAR' when lp.tenure_unit=7 then 'YEAR' end as time_unit,w.next_demand_scheduled_date,(abs(b.balance_magnitude)+
w.total_normal_interest_due_magnitude+w.total_penal_interest_due_magnitude+
w.booked_not_due_penal_interest_magnitude+w.booked_not_due_normal_interest_magnitude+
w.total_fee_due_magnitude) as NetPayoffDue,'' as uncollectedPrincipal,'' as
uncollectedInterest, '' as scheduledPaymentNumber,p.account_name,p.product_type,
p.product_code,p.branch_code, lp.penal_interest_rate,p.gl_subhead,p.opened_on_value_date,
 w.next_demand_run_date,w.last_demand_run_date,w.last_booking_date,b.last_archive_date,
 w.num_advance_satisfied_demands,w.booked_not_due_penal_interest_magnitude,
w.booked_normal_interest_magnitude,w.booked_penal_interest_magnitude,
w.total_disbursed_magnitude,w.total_repaid_magnitude,w.total_penal_interest_repaid_magnitude,
w.total_demand_due_magnitude,w.total_fee_repaid_magnitude, w.security_deposit_magnitude,w.npa 
from banks bk,account_balances b,loan_od_profiles lp,account_holders ah,account_profiles p,
loan_od_working_registers w left join loan_od_demands d on ( w.tenant_code = d.tenant_code
and w.account_id = d.account_id and w.oldest_due_demand_num = d.demand_num) left join
loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id)
where ah.holder_num=1
and w.account_id = b.account_id and w.tenant_code = b.tenant_code
and w.account_id = p.account_id and w.tenant_code = p.tenant_code
and lp.tenant_code=p.tenant_code and lp.account_id=p.account_id
and ah.tenant_code=p.tenant_code and ah.account_id=p.account_id
and bk.tenant_code = b.tenant_code and 
(p.operational_status != 1 or p.closed_on_transaction_date=DATE_SUB(bk.current_working_date,INTERVAL 1 DAY)) 
and w.tenant_code = $P{tenant_code};]]>
	</queryString>
