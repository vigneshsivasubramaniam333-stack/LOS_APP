POSTGRES_DB=losdb
POSTGRES_USER=losuser
POSTGRES_PASSWORD=Bltest@123

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083

# PLP api-gateway on host :8180. los-core runs in Docker — use host.docker.internal, not localhost.
PLP_BASE_URL=http://host.docker.internal:8180

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/losdb
SPRING_DATASOURCE_USERNAME=losuser
SPRING_DATASOURCE_PASSWORD=Bltest@123

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_USERNAME=losuser
SPRING_RABBITMQ_PASSWORD=lospassword
SPRING_RABBITMQ_PORT=5672