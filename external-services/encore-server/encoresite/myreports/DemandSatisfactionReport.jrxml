	<field name="branch_code" class="java.lang.String"/>
	<field name="amount" class="java.math.BigDecimal"/>
	<field name="currency" class="java.lang.String"/>
	<field name="demand_num" class="java.lang.Integer"/>
	<field name="demand_date" class="java.sql.Date"/>
	<field name="repayment_num" class="java.lang.Integer"/>
	<field name="value_date" class="java.sql.Date"/>
	<field name="RepaymentAmount" class="java.math.BigDecimal"/>
	<field name="Principal" class="java.math.BigDecimal"/>
	<field name="NormalInterest" class="java.math.BigDecimal"/>
	<field name="PenalInterest" class="java.math.BigDecimal"/>
	<field name="Forfeiture" class="java.math.BigDecimal"/>
