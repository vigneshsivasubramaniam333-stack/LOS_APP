	</parameter>
	<queryString>
		<![CDATA[select ifnull(c.gstin, "AAAA") as gstin, concat(COALESCE(c.first_name,''),' ',COALESCE(c.middle_name,''),' ',COALESCE(c.last_name,'')) as customerName,
 f.state_code as state_code,concat(COALESCE(c.address1,''),',',COALESCE(c.address2,''),',',COALESCE(c.address3,''),',',
 COALESCE(c.city_code,''),',',COALESCE(c.state_code,''),' - ',COALESCE(c.pin_code,''),' ')  as address,
 f.fee_category as fee_category,f.gross_amount_magnitude as gross_amount_magnitude,f.amount_magnitude as amount_magnitude,f.tax1_magnitude as tax1_magnitude,f.tax2_magnitude as tax2_magnitude,
 f.tax3_magnitude as tax3_magnitude,f.gross_amount_magnitude, f.charged_value_date as charged_value_date,
 f.account_id as account_id,b.state_code as bankStateCode,s.state_name as customerStateName,concat(COALESCE(b.address1,''),',',COALESCE(b.address2,''),',',COALESCE(b.address3,''),',',
 COALESCE(b.city_code,''),',',COALESCE(b.state_code,''),' - ',COALESCE(b.pin_code,'')) as bankAddress,
 b.registered_bank_name as registered_bank_name,ifnull(b.gstin, "BBBB") as bankGstin, case when f.tax2_magnitude=0.00 then 0.00 else t.tax_rate/2 end as tax2_rate,
 case when f.tax3_magnitude=0.00 then 0.00 else t.tax_rate/2 end as tax3_rate,
 case when f.tax1_magnitude=0.00 then 0.00 else t.tax_rate end as tax1_rate
from fees f, account_holders h, customers c, banks b,tax_rates t,states s where f.tenant_code=h.tenant_code and
t.id = (select max(tt.id) from tax_rates tt where f.charged_value_date>=tt.effective_date and f.charged_value_date<=tt.expiry_date ) and
f.tenant_code=c.tenant_code and f.tenant_code=b.tenant_code and c.tenant_code=s.tenant_code and c.state_code=s.state_code
and f.account_id=h.account_id and h.customer_id=c.customer_id and f.fee_category='Processing Fee' and
f.charged_value_date>=$P{from_date} and f.charged_value_date<=$P{to_date} and f.tenant_code=$P{tenant_code}
and (c.customer_id= $P{customerId_text} or $P{customerId_text} is null)
and (h.account_id=$P{accountId_text} or $P{accountId_text} is null)]]>
	</queryString>
