	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date Preceding]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date Preceding]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[Branchset Code]]></parameterDescription>
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<parameter name="instrument_select" class="java.lang.String">
		<parameterDescription><![CDATA[InstrumentSelect]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT ld.account_id,ah.customer_id,concat(ah.first_name," ",ah.middle_name," ",ah.last_name) as customerName,ld.description,ap.branch_code,ap.product_code,ld.value_date,ld.transaction_date,ld.amount_magnitude,
(ld.principal_magnitude+ld.principal_adjustment_magnitude) as Principal,
(ld.normal_interest_magnitude+ld.normal_interest_adjustment_magnitude) as NormalInterest,
(ld.penal_interest_magnitude+ld.penal_interest_adjustment_magnitude) as PenalInterest,
(ld.amount_magnitude-(ld.principal_magnitude+ld.principal_adjustment_magnitude+
ld.normal_interest_magnitude+ld.normal_interest_adjustment_magnitude+
ld.penal_interest_magnitude+ld.penal_interest_adjustment_magnitude)) as Forfeiture, ld.transaction_id,
u.name as user_id,ld.instrument,ld.account_code as accountCode,
ld.created_at,ld.repayment_type,lt.tag,(lp.normal_interest_rate*100), 
b.branch_name, ld.old_dpd, ld.dpd,c.sector, ld.interest_tds_magnitude, 
concat(COALESCE(la.first_name,''),' ',COALESCE(la.middle_name,''),' ',COALESCE(la.last_name)) as guarantorName, 
case when w.oldest_due_demand_num = 0 then 0 else datediff(bk.current_working_date, d.demand_date) end as dpd,
case when w.oldest_due_demand_num = 0 then 0 else case when ht.effective_date is null then datediff(bk.current_working_date, d.demand_date) 
when  datediff(d.demand_date, ht.effective_date) > 0 then datediff(bk.current_working_date, d.demand_date) 
else datediff(bk.current_working_date, d.demand_date) - least(datediff(bk.current_working_date, ht.effective_date), (datediff( ht.expiry_date, ht.effective_date)+1)) end end as effective_dpd 
FROM banks bk,account_profiles ap ,customers c, account_holders ah, loan_od_working_registers w left join loan_od_demands d on ( w.tenant_code = d.tenant_code 
and w.account_id = d.account_id and w.oldest_due_demand_num = d.demand_num) left join loan_od_tags lt on (w.tenant_code = lt.tenant_code and w.account_id = lt.account_id) 
left join loan_od_history_tags ht on (w.tenant_code=ht.tenant_code and w.account_id=ht.account_id and ht.classifier='Moratorium'),
branchset_branches bs,branches b,loan_od_profiles lp left join loan_od_associates la on la.tenant_code=lp.tenant_code and la.account_id = lp.account_id and la.associate_type=1 and la.sequence_num=1 
left join customers cs on (la.tenant_code=cs.tenant_code and la.associate_id=cs.customer_id),
loan_od_repayments ld left join users u on (ld.tenant_code = u.tenant_code and ld.user_id=u.userid) 
where lp.tenant_code=ap.tenant_code and bs.tenant_code=b.tenant_code and w.account_id = ap.account_id and w.tenant_code = ap.tenant_code and 
ld.tenant_code=ap.tenant_code and ap.tenant_code=ah.tenant_code and c.tenant_code=ah.tenant_code and 
ah.tenant_code=bs.tenant_code and ap.account_id=ah.account_id and ap.account_id=lp.account_id and ah.holder_num=1 and c.customer_id=ah.customer_id and bs.branch_code=b.branch_code and
ld.account_id=ap.account_id and ap.branch_code=bs.branch_code and bk.tenant_code=ap.tenant_code and ap.tenant_code=$P{tenant_code}
and   bs.branchset_code =$P{branchset_code_select} and (ld.instrument=$P{instrument_select} or $P{instrument_select}='' or $P{instrument_select} is null)
and (ld.transaction_date>=$P{from_date} and ld.transaction_date<=$P{to_date});]]>
	</queryString>
