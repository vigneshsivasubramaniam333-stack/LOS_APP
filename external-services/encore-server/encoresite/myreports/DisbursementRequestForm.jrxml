	<parameter name="accountId_text" class="java.lang.String">
		<parameterDescription><![CDATA[AccountId]]></parameterDescription>
	</parameter>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ld.account_id,ld.amount_magnitude,ld.value_date,b.bank_name,c.ifsc_code1,br.branch_name,
ah.customer_id,ah.first_name,ah.middle_name,ah.last_name,
ah.customer_id,ah.first_name,ah.middle_name,ah.last_name,
concat(ifnull(ah.first_name,''),' ',ifnull(ah.middle_name,''),' ',ifnull(ah.last_name,'')) as customer_name,ld.value_date
from 
loan_od_disbursements ld,account_holders ah,banks b,customers c,branches br,account_profiles ap
where ld.account_id=ah.account_id and ld.account_id=ap.account_id and ld.account_id=ah.account_id 
and ah.customer_id=c.customer_id and br.branch_code=ap.branch_code and
ld.tenant_code=ah.tenant_code and ld.tenant_code=b.tenant_code and ah.tenant_code=c.tenant_code 
and br.tenant_code=ap.tenant_code and ld.tenant_code=$P{tenant_code}
and ld.account_id=$P{accountId_text}]]>
	</queryString>
	<field name="bank_name" class="java.lang.String"/>
	<field name="amount_magnitude" class="java.lang.String"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="ifsc_code1" class="java.lang.String"/>
	<field name="branch_name" class="java.lang.String"/>
