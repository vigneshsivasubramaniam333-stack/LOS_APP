<!-- Created with Jaspersoft Studio version 6.4.0.final using JasperReports Library version 6.4.1  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HighmarkReport" language="groovy" pageWidth="8500" pageHeight="842" columnWidth="8500" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="6a3afdfb-6dba-4047-84ab-39dd379d19a8">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="2055"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select c.first_name,c.middle_name,case when c.last_name is null then SUBSTRING_INDEX(c.first_name, ' ', -1) else c.last_name end as last_name ,c.date_of_birth,
c.gender,c.pan,c.uid_num,c.phone1,c.phone2,c.email,
concat(c.address1,',',c.address2,',',c.address3),c.city_code,c.district_code,case when s.state_name='Jammu & Kashmir' then '01' when s.state_name='Himachal Pradesh' then '02' when s.state_name='Punjab' then '03' 
		when s.state_name='Chandigarh' then '04' when s.state_name in ('Uttaranchal','Uttarakhand') then '05' when s.state_name='Haryana' then '06' 
		when s.state_name='Delhi' then '07' when s.state_name='Rajasthan' then '08' when s.state_name='Uttar Pradesh' then '09' 
		when s.state_name='Bihar' then '10' when s.state_name='Sikkim' then '11' when s.state_name='Arunachal Pradesh' then '12' 
		when s.state_name='Nagaland' then '13' when s.state_name='Manipur' then '14' when s.state_name='Mizoram' then '15' 
		when s.state_name='Tripura' then '16' when s.state_name='Meghalaya' then '17' when s.state_name='Assam' then '18' 
		when s.state_name='West Bengal' then '19' when s.state_name='Jharkhand' then '20' when s.state_name='Orissa' then '21' 
		when s.state_name='Chhattisgarh' then '22' when s.state_name='Madhya Pradesh' then '23' when s.state_name='Gujarat' then '24' 
		when s.state_name='Daman & Diu' then '25' when s.state_name='Dadra & Nagar Haveli' then '26' when s.state_name='Maharashtra' then '27' 
		when s.state_name='Andhra Pradesh' then '28' when s.state_name='Karnataka' then '29' when s.state_name='Goa' then '30' 
		when s.state_name='Lakshadweep' then '31' when s.state_name='Kerala' then '32' when s.state_name='Tamil Nadu' then '33' 
		when s.state_name='Pondicherry' then '34' when s.state_name='Andaman & Nicobar Islands' then '35' else '90' end as state_code,s.state_name,c.pin_code,
concat(c.alt1_address1,',',c.alt1_address2,',',c.alt1_address3),c.alt1_city_code,c.alt1_district_code,
c.alt1_state_code,c.alt1_pin_code,lp.account_id,lr.first_disbursement_date,lr.last_repayment_date,
ap.closed_on_value_date,b.current_working_date,lp.amount_magnitude,ab.balance_magnitude,lr.total_demand_due_magnitude,
lp.normal_interest_rate,lr.installment_amount_magnitude,case when lp.tenure_unit=2 then '01'
when lp.tenure_unit=3 then '02' when lp.tenure_unit=4 then '03' when lp.tenure_unit=5 then '04' end as frequency,
case when lr.oldest_due_demand_num = 0 then 0 else datediff(b.current_working_date, d.demand_date)
end as dpd,lr.asset_category, c.customer_id, c.customer_type,c.document_number1,c.document_type1 
from customers c, loan_od_profiles lp, loan_od_working_registers lr left join loan_od_demands d on
(lr.tenant_code = d.tenant_code and lr.account_id = d.account_id and lr.oldest_due_demand_num = d.demand_num),
 account_balances ab,account_holders ah, account_profiles ap, banks b,states s
where b.tenant_code=s.tenant_code and b.tenant_code=lp.tenant_code and c.tenant_code=lp.tenant_code and lp.tenant_code=lr.tenant_code and lr.tenant_code=ab.tenant_code and c.state_code=s.state_code and
ab.tenant_code=ah.tenant_code and ap.tenant_code=lp.tenant_code and lp.account_id=ah.account_id and ab.account_id=lp.account_id
and c.customer_id=ah.customer_id and lp.account_id=lr.account_id and ap.account_id=lp.account_id and
lp.tenant_code= $P{tenant_code}  and c.customer_type=0 and c.first_name not like '%SHG%' and c.first_name  not like '%JLG%' 
and c.first_name not like '%COMPANY%' and c.first_name not like '%LTD%' and c.first_name not like '%LIMITED%' and 
c.first_name not like '%SOCIETY%' and c.first_name not like '%KULU%' and c.first_name not like '%SUKS%' and 
c.first_name not like '%GROUP%' and c.first_name not like '%FARMER' and c.last_name not like '%SHG%' and 
c.last_name not like '%JLG%' and c.last_name not like '%COMPANY%' and c.last_name not like '%LTD%' and 
c.last_name not like '%LIMITED%' and c.last_name not like '%SOCIETY%' and c.last_name not like '%KULU%' and 
c.last_name not like '%SUKS%' and c.last_name not like '%GROUP%' and c.last_name not like '%FARMER%' and 
c.date_of_birth is not null  and ((c.phone1 is not null and c.phone1 != '' and c.phone1 != '0') or 
(c.phone2 is not null and c.phone2 != '' and c.phone2 != '0')) and ((c.pan !='' and c.pan is not null) or (c.uid_num!='' and c.uid_num 
is not null) or ((document_number1 is not null and document_number1 !='') or (document_type1='uid%' and document_type1 ='Uid%')))]]>
	</queryString>
