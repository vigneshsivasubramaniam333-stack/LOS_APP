<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EodCompletionReport" language="groovy" pageWidth="400" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="400" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="c9f8c153-b998-4605-8526-69178adc1406">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select p.account_id, w.last_booking_date, w.next_demand_run_date from
loan_od_working_registers w, account_profiles p , banks b where b.tenant_code = w.tenant_code
and w.tenant_code = p.tenant_code and p.tenant_code = $P{tenant_code} and p.account_id=w.account_id and ( ( w.next_demand_run_date is not null and w.next_demand_run_date <= b.current_working_date ) or w.last_booking_date < subdate(b.current_working_date, 1) or w.last_booking_date is null ) and p.operational_status = 0 order by p.account_id]]>
	</queryString>
	<field name="account_id" class="java.lang.String"/>
	<field name="last_booking_date" class="java.sql.Date"/>
	<field name="next_demand_run_date" class="java.sql.Date"/>
