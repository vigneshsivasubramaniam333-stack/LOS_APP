	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[Branchset Code]]></parameterDescription>
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select d.account_id,d.demand_num,d.demand_date,d.scheduled_demand,d.amount_magnitude,
d.principal_magnitude,d.normal_interest_magnitude,d.penal_interest_magnitude,
d.demand_adjustment_magnitude, d.principal_currency from loan_od_demands d, branchset_branches b,
account_profiles ap where d.tenant_code = ap.tenant_code and d.account_id = ap.account_id and
ap.tenant_code = b.tenant_code and ap.branch_code = b.branch_code and
d.tenant_code = b.tenant_code and d.tenant_code =$P{tenant_code}  and b.branchset_code=$P{branchset_code_select}
and (d.demand_date >=$P{from_date} and d.demand_date <=$P{to_date})  order by d.demand_num]]>
	</queryString>
