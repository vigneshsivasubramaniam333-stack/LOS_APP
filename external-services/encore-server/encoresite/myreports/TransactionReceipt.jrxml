	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="imagePath" class="java.lang.String"/>
	<parameter name="transactionId_text" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{imagePath}.split( "images" )[0]+"myreports/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select bk.bank_name,lr.tenant_code,lr.repayment_num,br.branch_name,lr.transaction_id,lr.account_id, lr.amount_magnitude,lr.transaction_date, concat(ah.first_name," ",middle_name," ",last_name) as customerName
from loan_od_repayments lr,account_profiles ap,branches br,account_holders ah,banks bk where br.tenant_code=bk.tenant_code and
lr.tenant_code=ap.tenant_code and ah.tenant_code=ap.tenant_code and br.tenant_code=ap.tenant_code
and lr.account_id=ap.account_id and ap.account_id=ah.account_id and ap.branch_code=br.branch_code
and lr.tenant_code=$P{tenant_code} and lr.transaction_id=$P{transactionId_text}
UNION 
select bk.bank_name,lr.tenant_code,lr.id,br.branch_name,lr.transaction_id,lr.account_id, lr.amount_magnitude,lr.transaction_date, concat(ah.first_name," ",middle_name," ",last_name) as customerName
from loan_od_write_offs lr,account_profiles ap,branches br,account_holders ah,banks bk where br.tenant_code=bk.tenant_code and
lr.tenant_code=ap.tenant_code and ah.tenant_code=ap.tenant_code and br.tenant_code=ap.tenant_code
and lr.account_id=ap.account_id and ap.account_id=ah.account_id and ap.branch_code=br.branch_code and lr.write_off_transaction_type in (2,3)
and lr.tenant_code=$P{tenant_code} and lr.transaction_id=$P{transactionId_text}]]>
	</queryString>
