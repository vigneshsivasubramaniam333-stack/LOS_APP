<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PayOffAmountReport" pageWidth="1000" pageHeight="842" columnWidth="1000" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="b4b89a77-90a6-471a-868b-ceeb74f54b1a">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="encoredb"/>
	<parameter name="userId_text" class="java.lang.String">
		<parameterDescription><![CDATA[RM]]></parameterDescription>
	</parameter>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select w.account_id, ap.branch_code, bc.branch_name, ap.product_code, c.customer_id, c.phone1, lp.amount_magnitude, 
(w.total_fee_due_magnitude+w.booked_not_due_normal_interest_magnitude+w.booked_not_due_penal_interest_magnitude+w.total_normal_interest_due_magnitude+
w.total_penal_interest_due_magnitude+(-ab.balance_magnitude)) as payOffAmount
from loan_od_working_registers w,banks b, account_holders h, customers c, account_balances ab, account_profiles ap, branches bc, loan_od_profiles lp 
where h.tenant_code=lp.tenant_code 
and h.tenant_code=ap.tenant_code 
and h.tenant_code=bc.tenant_code 
and h.tenant_code=ab.tenant_code 
and h.tenant_code=c.tenant_code 
and h.tenant_code=b.tenant_code 
and h.tenant_code=w.tenant_code 
and h.customer_id=c.customer_id and h.holder_num=1 
and w.account_id=ab.account_id 
and w.account_id=h.account_id 
and w.account_id=ap.account_id 
and w.account_id=lp.account_id 
and ap.branch_code=bc.branch_code 
and date_add(b.current_working_date, INTERVAL 3 DAY) = w.next_demand_run_date 
and c.relationship_manager= $P{userId_text}  and h.tenant_code =  $P{tenant_code} 
]]>
	</queryString>
	<field name="account_id" class="java.lang.String"/>
	<field name="branch_code" class="java.lang.String"/>
