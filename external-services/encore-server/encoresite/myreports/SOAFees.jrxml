	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Sample DB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="accountId_text" class="java.lang.String">
		<parameterDescription><![CDATA[Account ID]]></parameterDescription>
	</parameter>
	<parameter name="tenant_code" class="java.lang.String"/>
	<queryString>
		<![CDATA[select f.fee_category, sum(f.gross_amount_magnitude) as fee, ifnull(sum(fp.paid_amount_magnitude),0) as paid, sum(f.gross_amount_magnitude)- ifnull(sum(fp.paid_amount_magnitude),0) as due from fees f left join fee_payments fp on(f.fee_num=fp.fee_num and f.account_id=fp.account_id and f.tenant_code=fp.tenant_code)
 where f.account_id=$P{accountId_text} and f.tenant_code=$P{tenant_code} and f.payment_status=0
 group by f.fee_category]]>
	</queryString>
	<field name="fee_category" class="java.lang.String"/>
	<field name="due" class="java.lang.Integer"/>
