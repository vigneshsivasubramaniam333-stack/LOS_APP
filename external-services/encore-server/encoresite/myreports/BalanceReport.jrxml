	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="encoredb"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="294"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="697"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="from_date" class="java.sql.Date">
		<parameterDescription><![CDATA[Date]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[select p.account_id,p.branch_code,p.product_code,b.balance_magnitude as closingBalance,
sum(case when e.account_entry_type=1 then e.amount_magnitude else 0 end) as debitAmount,
sum(case when e.account_entry_type=0 then e.amount_magnitude else 0 end) as creditAmount
from account_balances b, account_profiles p left join account_entries e 
on (p.tenant_code=e.tenant_code and p.account_id=e.account_id and e.transaction_date=$P{from_date} )
where b.tenant_code=p.tenant_code and b.account_id=p.account_id  and
b.tenant_code=$P{tenant_code}  group by p.account_id,p.branch_code,p.product_code,b.balance_magnitude]]>
	</queryString>
	<field name="account_id" class="java.lang.String"/>
	<field name="branch_code" class="java.lang.String"/>
	<field name="product_code" class="java.lang.String"/>
	<field name="closingBalance" class="java.math.BigDecimal"/>
	<field name="debitAmount" class="java.math.BigDecimal"/>
	<field name="creditAmount" class="java.math.BigDecimal"/>
