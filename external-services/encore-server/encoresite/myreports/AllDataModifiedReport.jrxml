		<property name="com.jaspersoft.studio.field.label" value="total_fee_due_magnitude"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="loan_od_working_registers"/>
	</field>
	<field name="total_penal_interest_due_magnitude" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="total_penal_interest_due_magnitude"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="loan_od_working_registers"/>
	</field>
	<field name="lateChargeAsseseedLife" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="lateChargeAsseseedLife"/>
	</field>
	<field name="balance_magnitude" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="balance_magnitude"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="account_balances"/>
	</field>
	<field name="bal" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="bal"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="account_balances"/>
	</field>
	<field name="total_principal_due_magnitude" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="total_principal_due_magnitude"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="loan_od_working_registers"/>
	</field>
	<field name="total_normal_interest_due_magnitude" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="total_normal_interest_due_magnitude"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="loan_od_working_registers"/>
