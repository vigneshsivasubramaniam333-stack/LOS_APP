	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant_code" class="java.lang.String"/>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[Branchset Code]]></parameterDescription>
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select gl.gl_head, ap.gl_subhead, ap.product_code,p.category, ap.branch_code,ap.currency_code,ap.product_type,br.branch_name,sum(ab.balance_magnitude)
from account_balances ab, account_profiles ap, gl_subheads gl,branches br,products p
where ab.account_id = ap.account_id and ap.gl_subhead = gl.gl_subhead and ap.tenant_code = gl.tenant_code
and ap.currency_code=p.currency_code and ap.product_code=p.product_code and
ap.product_type=p.product_type and ab.tenant_code = ap.tenant_code and ap.tenant_code=p.tenant_code and
 ab.tenant_code = $P{tenant_code} and ap.branch_code in (select b.branch_code from branchset_branches b
where b.branchset_code = $P{branchset_code_select} and b.tenant_code = $P{tenant_code}) and
br.branch_code = ap.branch_code and br.tenant_code = ap.tenant_code
group by gl.gl_head,ap.tenant_code,ap.gl_subhead,ap.product_type,ap.product_code,ap.currency_code,ap.branch_code order by gl.gl_head]]>
	</queryString>
	<field name="gl_head" class="java.lang.String"/>
	<field name="gl_subhead" class="java.lang.String"/>
	<field name="product_code" class="java.lang.String"/>
	<field name="category" class="java.lang.String"/>
	<field name="branch_code" class="java.lang.String"/>
	<field name="branch_name" class="java.lang.String"/>
	<field name="sum(ab.balance_magnitude)" class="java.math.BigDecimal"/>
	<field name="product_type" class="java.lang.String"/>
	<field name="currency_code" class="java.lang.String"/>
