<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Demand Satisfaction report" pageWidth="1000" pageHeight="842" columnWidth="940" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="253b1ef2-1b77-47dd-99dc-fdf9b5fffbdf">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="tenant_code" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["KGFS"]]></defaultValueExpression>
	</parameter>
	<parameter name="from_date" class="java.util.Date">
		<parameterDescription><![CDATA[From Date]]></parameterDescription>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<parameterDescription><![CDATA[To Date]]></parameterDescription>
	</parameter>
	<parameter name="branchset_code_select" class="java.lang.String">
		<parameterDescription><![CDATA[Branch / Branch Set code]]></parameterDescription>
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select d.account_id as account_id, b.branch_code,
d.amount_magnitude as amount, d.amount_currency as currency,
MIN(d.demand_num) as demand_num, d.demand_date,
r.repayment_num, r.value_date,
 r.amount_magnitude as RepaymentAmount, (r.principal_magnitude+r.principal_adjustment_magnitude) as Principal,
(r.normal_interest_magnitude+r.normal_interest_adjustment_magnitude) as NormalInterest,
(r.penal_interest_magnitude+r.penal_interest_adjustment_magnitude) as PenalInterest,
(r.amount_magnitude-(r.principal_magnitude+r.principal_adjustment_magnitude+
r.normal_interest_magnitude+r.normal_interest_adjustment_magnitude+
r.penal_interest_magnitude+r.penal_interest_adjustment_magnitude)) as Forfeiture

from loan_od_demands d, loan_od_repayments r,  branchset_branches b,
account_profiles ap

where
d.tenant_code = r.tenant_code  and d.account_id = r.account_id and
d.tenant_code = ap.tenant_code and d.account_id = ap.account_id and
ap.tenant_code = b.tenant_code and ap.branch_code = b.branch_code and
b.branchset_code=$P{branchset_code_select} and d.tenant_code =
$P{tenant_code} and
d.demand_date >=$P{from_date} and d.demand_date <=$P{to_date} and
r.last_satisfied_demand_num >= d.demand_num group by d.account_id, d.demand_num]]>
	</queryString>
